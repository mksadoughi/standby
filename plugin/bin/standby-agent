STOPPED = "(stopped)"     # the answer of a question cancelled with `cancel`

# Claude Code that cannot sign in: what it writes to its log then, where
# every call would otherwise end in an error after ~40 s of retries. Only Claude
# Code's own words and the cloud SDKs' it signs in through, never one setup's. Two
# kinds. One that never gets better by itself ends a turn that has heard nothing
# from Claude at once. One that may still get its credentials (a fallback, a slow
# network) ends it only after SIGNIN_SOFT_WAIT with nothing. With what to do, by how
# Claude Code signs in (SIGNIN_FIXES); the next turn tries again.
SIGNIN_FATAL = (
    # Claude Code's own: its account, or an API key ("Invalid API key · Please run /login")
    "Invalid API key", "Please run /login", "Not logged in",
    # Google's auth library, for Claude Code on Vertex AI
    "Could not load the default credentials")
SIGNIN_SOFT = ()          # Claude Code's own, while it may still get them: none known now
SIGNIN_MARKS = SIGNIN_FATAL + SIGNIN_SOFT
SIGNIN_GOOGLE = ("default credentials", "Google", "gcloud")
SIGNIN_FIXES = {
    "google": "Your Google Cloud credentials need refreshing",
    "api_key": "Check Claude Code's API key",
    "account": "Sign in to Claude Code again (run claude, then /login)",
}
SIGNIN_GRACE = float(os.environ.get("STANDBY_SIGNIN_GRACE", 1))           # after one that never recovers
SIGNIN_SOFT_WAIT = float(os.environ.get("STANDBY_SIGNIN_SOFT_WAIT", 20))  # after one that may, from the turn's start
SIGNIN_FRESH = 60.0       # an engine this new that has not answered yet: its own start's lines count too
SIGNIN_BACKOFF = float(os.environ.get("STANDBY_SIGNIN_BACKOFF", 60))  # listen pushes wait this long after one
SIGNIN_SAID = "I can't reach Claude: it can't sign in."
# Voice mode has its own conversation on a quick model, kept small so it answers
# fast. The meeting agent (--model) stays the brain: it listens to everything,
# takes the typed questions, and leaves notes the voice reads. When the voice
# needs real work it replies [DEEP] and the meeting agent answers, out loud.
DEEP_TAG = "[DEEP]"
# In a call from the user's own Claude Code session (live/<session>.voice.json says "handoff"),
# real work goes to that session instead: the answer is HANDOFF_TAG and the user's words, which
# the Mac hands on, and the voice stays free to talk while the session works.
HANDOFF_TAG = "[HANDOFF]"
# When that work finishes (or stops, or fails), the Mac sends its result as a voice turn that
# starts "[RESULT <how>]": the voice tells the user in its own words, as its own work, never
# reading out what was written (a path, code), which stays in Claude Code's chat.
RESULT_RE = re.compile(r"^\[RESULT(?: ([a-z]+))?\]\s*(.*)$", re.S)
RESULT_HOW = {"done": "is done", "aborted": "was stopped before it finished", "error": "ran into an error",
              "undelivered": "never reached the session, so none of it was done",
              "queued": "hasn't started yet: your session is still on earlier work, and starts this once that's done"}
RESULT_TURN = "[RESULT] Not from the user: the work you took deeper %s. What it came to:\n<<<\n%s\n>>>"
# A result that came while the user was talking: with their turn, after their words and as background,
# so what they just said is what the voice answers (the Mac holds it for them: ui.lite_ask)
RESULT_LATER = ("[RESULT] Background, not from the user: the work you took deeper %s while they were "
                "talking. What they said comes first; this can wait for a natural moment. What it came to:\n<<<\n%s\n>>>")
RESULT_IN_TURN = re.compile(r"\[RESULT(?: ([a-z]+))?\]\s*(.*?)\n\[END RESULT\]\n?", re.S)
# Back from a pause where something waited (the bell): one turn, "[RESUMED] …", with what came back meanwhile
# as information; not the user's words, and nothing handed on from it (the Mac's _lite_tell)
RESUMED_TAG = "[RESUMED]"
QUIET_TAG = "[QUIET]"     # the voice chose to say nothing now
CANCEL_RE = re.compile(r"\[CANCEL\s*#?(\d+)\]")   # the voice stops a task of the call's by its number (the Mac does it)
END_TAG = "[END]"         # after its goodbye: the voice ends the call
CALL_START = "[CALL START]"   # a call's first turn, before the user speaks (the Mac's LITE_OPENING)
# A call from the user's own Claude Code session (voice.json "handoff"): few words, principles
# only. The voice IS that session, speaking: its quick, live side; [DEEP] is its own deeper side.
CALL_VOICE_PRELUDE = """You are the user's Claude Code session{folder}, on a voice call with them: its
mouth and ears. It's all you: same agent, same work, same memory, so never speak of a
separate agent or helper. You're heard, not read: brief and natural, never reading out
paths, code, markdown or lists.

Your own tools are for looking: you can read and search where your session works,
and ~/.standby. Anything that does something, like changing a file, running a command
or searching the web, is your deeper side's: this whole Claude Code session, with all
its context and every tool and connection it has. So whatever they ask for is yours
to do: reply [DEEP] and what to do, in your words, with what it needs to know. Don't
try it yourself first; a tool refusing you only means it's your deeper side's to do,
never that it can't be done. Answer them first, then take it deeper; it works while
you keep talking.

Only your session's notes say what has happened, so never guess: nothing has started
until a [SESSION] note says your session has it (till then, you're sending it), and a
[RESULT] says what it came to. A result is background; what they're saying comes
first. At a natural moment, give the gist and let them ask; with a lot, ask first if
they want it.

[CALL START] means the call just connected: reply with only a hello your way, under
ten words in all, naming anything you're picking up. To say nothing, reply [QUIET]. Ending the call is
yours: when they ask, or are clearly done, say goodbye and add [END]; if unsure, ask.
"""
# A call's voice when each turn is built from the call's record (sbledger): the blocks say who said what,
# so this says only how to read them.
CALL_LEDGER_PRELUDE = """<role>
You are the user's Claude Code session{folder}, on a voice call with them: its mouth and ears. It's all you: the work you hand on is your own deeper side, so speak of it as yours, never as a separate agent or helper.
</role>

<how_you_sound>
They're listening, not reading, so keep it brief and natural: a sentence or two, then let them talk. Go longer when they ask you to explain something. Say what paths, code, markdown or lists mean instead of reading them out. Vary your wording so you don't sound scripted.
</how_you_sound>

<the_call>
Each turn shows the call so far, oldest first. THEM is what they said, as speech-to-text heard it. YOU is what they actually heard from you; [cut here] marks where they stopped you, so pick up from what they say next, and repeat the cut part only if they ask. TASKS is the work you've handed on, as it stands now. Answer their last words.
</the_call>

<hearing>
Speech-to-text mishears names and words, and can catch other voices in the room. When a word sounds wrong, read it as the likely one; when you can't tell what they meant, ask briefly rather than guess. Talk that clearly isn't meant for you, like background voices, needs no reply.
</hearing>

<work>
Your own tools are for looking: you can read and search where your session works, and ~/.standby. Anything that does something, like changing a file, running a command or browsing the web, is your deeper side's: say a short line so they know, then [DEEP] and what to do, with what it needs to know; it runs while you keep talking. Your deeper side is this whole Claude Code session, with all its context on this project and the user's work and every tool and connection it has, so anything they could ask Claude Code to do, you can do by taking it deeper. Take it deeper at once instead of trying it yourself; if one of your tools refuses you, that only means it's your deeper side's to do, never that it can't be done. Only TASKS tells you what has started or finished, so when it doesn't say, tell them you don't know yet rather than guess. To stop a task, add [CANCEL #n] with its number from TASKS; to change one, stop it and send the new work with [DEEP]. A RESULT is background: at a natural moment, give the gist in your own words, in a sentence or two, rather than reading the session's text out.
</work>

<flow>
[CALL START] means the call just connected: a short hello, naming their last message in a few words if there is one; answer it once they pick it up. To say nothing this turn, reply [QUIET]. When they're done, say goodbye and add [END]; if you're unsure, ask.
</flow>
"""
VOICE_BRIEF_LINES = 120   # the voice starts from the last ~10 minutes; older is in the notes
VOICE_CONTEXT_CHARS = 700
LISTEN_TIMEOUT = 90     # idle seconds before a listen turn is abandoned
POLL = 0.03             # spool and progress polling: these add straight to every answer
LISTEN_MAX = 300        # and an absolute ceiling, so listening never runs away


def user_interactive():
    """This thread at user-interactive QoS: run before the default work of everything else on a
    busy Mac (mac/qos.py's, for the agent, which is installed on its own). Never raises."""
    if sys.platform != "darwin":
        return False
    try:
        import ctypes
        lib = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
        lib.pthread_set_qos_class_self_np.argtypes = [ctypes.c_uint, ctypes.c_int]
        return lib.pthread_set_qos_class_self_np(0x21, 0) == 0
    except Exception:
        return False


def die(msg, code=1):
    sys.stderr.write("standby-agent: %s\n" % msg)
    sys.exit(code)


def ensure_dirs():
    for path in (AGENT, SPOOL):
        # exist_ok: two agents starting at once both found it missing, and the second
        # one's makedirs raised (test_one_server, four at once in a fresh root).
        os.makedirs(path, exist_ok=True)
        os.chmod(path, 0o700)   # holds meeting content: owner only


# A session's name goes into paths here (agent/<name>.uuid, live/<name>.jsonl...): only
# letters, digits, - and _, as the Mac makes them; never "." or "..", never a slash, so
# never a path above or beside them. "none": no
# session. Not the Mac's exact shape: the agent never makes one, and older clients and
# its own tests name them shortly; what matters here is that a name is never a path.
SESSION_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$")


def session_name(name):
    """name, if it is safe as a session's name in a path; else None."""
    return name if isinstance(name, str) and (name == "none" or SESSION_NAME.match(name)) else None


def current_session():
    pointer = os.path.join(LIVE, "CURRENT")
    if os.path.exists(pointer):
        with open(pointer) as fh:
            name = fh.read().strip()
            if name:
                return session_name(name) or "none"       # a CURRENT that isn't a name: no session
    return "none"


def uuid_path(session):
    return os.path.join(AGENT, "%s.uuid" % session)


def session_uuid(session, create=True):
    """One stable conversation per meeting, so context accumulates.

    create=False for read-only callers. This used to always create, and because
    `status` called it, merely checking status minted a conversation id that no
    real Claude conversation backed. The next real question then ran
    `--resume <phantom>` and died with "No conversation found".
    """
    path = uuid_path(session)
    if os.path.exists(path):
        with open(path) as fh:
            value = fh.read().strip()
        if value:
            return value, False
    attach = attached(session)
    if attach and not attach.get("copy"):
        value, fresh = attach["from"], False       # the user's own conversation: resumed, never new
    elif not create:
        return None, False
    else:
        value, fresh = str(uuid.uuid4()), True
        if attach:                                  # a copy of it, made at its first turn under this id
            ensure_dirs()
            with open(fork_path(session), "w") as fh:
                fh.write(attach["from"] + "\n")
    if create:
        ensure_dirs()
        with open(path, "w") as fh:
            fh.write(value + "\n")
    return value, fresh


# ------------------------------------------------------------------ attaching
#
# A meeting or a talk can run on one of the user's own Claude Code conversations
# instead of a new one, as they chose (2026-10-07): the same conversation, resumed in
# its own folder, the transcript pushed into it as into any meeting. Or on a copy of
# it, made at its first turn (`--fork-session`, under an id chosen here). The Mac puts
# {"attach": {"from": <id>, "copy": bool}} in the session's meta.
#
# Never two writers: two split a conversation (see `hold`). Claude Code keeps a
# registry of its running sessions, ~/.claude/sessions/<pid>.json, each with its
# sessionId. One that has this conversation and is not in this agent's process group
# (its own Claude Codes are: measured, the launcher's child stays in it) is someone
# else's, in Terminal or an editor, and the conversation is held for it as `hold`
# holds it: no turn, no transcript (it waits unsent, then goes once), until it closes.

UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
REGISTRY = os.path.expanduser("~/.claude/sessions")
ELSEWHERE = "elsewhere"           # in a hold file: held for a Claude Code the registry shows


def attached(session):
    """{"from": <id>, "copy": bool} if this session runs on one of the user's own
    conversations, else None."""
    a = session_meta(session).get("attach")
    if isinstance(a, dict) and isinstance(a.get("from"), str) and UUID_RE.match(a["from"]):
        return {"from": a["from"], "copy": bool(a.get("copy"))}
    return None


def fork_path(session):
    return os.path.join(AGENT, "%s.fork" % session)


def fork_of(session):
    """The conversation a copy is still to be made from, or None: the copy exists
    once its own transcript does."""
    try:
        with open(fork_path(session)) as fh:
            source = fh.read().strip()
    except (IOError, OSError):
        return None
    sid = session_uuid(session, create=False)[0]
    if sid and glob.glob(os.path.expanduser("~/.claude/projects/*/%s.jsonl" % sid)):
        _remove(fork_path(session))
        return None
    return source if UUID_RE.match(source) else None


def running_claudes():
    """Claude Code's registry of running sessions, live processes only (sbagents)."""
    return sbagents.running_claudes(REGISTRY)


opened_where = sbagents.opened_where     # where a running Claude Code is, in the user's words


def open_conversations():
    """{conversation id: opened_where} for every live Claude Code in the registry
    that isn't Standby's own (the serving agent's engines share its process group),
    read now, never kept: a window closed a moment ago is gone at once. A record
    with no pid, or one whose process has ended, isn't open. Several for one id:
    a busy one wins."""
    mine = None
    pid = server_pid()
    if pid is not None:
        try:
            mine = os.getpgid(pid)
        except OSError:
            mine = None
    out = {}
    for entry in running_claudes():
        sid = entry.get("sessionId")
        if not isinstance(sid, str) or not sid:
            continue
        try:
            if mine is not None and os.getpgid(entry["pid"]) == mine:
                continue
        except OSError:
            continue                              # ended between the two looks
        seen = opened_where(entry)
        if sid not in out or (seen["busy"] and not out[sid]["busy"]):
            out[sid] = seen
    return out


def open_elsewhere(sid):
    """The pid of a Claude Code that is not this agent's own and has conversation
    `sid` open, or None."""
    if not sid:
        return None
    mine = os.getpgrp()
    for entry in running_claudes():
        if entry.get("sessionId") != sid:
            continue
        try:
            if os.getpgid(entry["pid"]) == mine:
                continue
        except OSError:
            continue
        return entry["pid"]
    return None


def guard(session):
    """Before any write to this session's conversation: if something else has it
    open, hold it (as `hold` does) and return that pid; else None."""
    if session in (None, "none"):
        return None
    pid = holder(session)
    if pid is not None:
        return pid
    pid = open_elsewhere(session_uuid(session, create=False)[0])
    if pid is None:
        return None
    ensure_dirs()
    path = hold_path(session)
    with open(path + ".tmp", "w") as fh:
        fh.write("%d %s\n" % (pid, ELSEWHERE))
    os.rename(path + ".tmp", path)
    return pid


def held_elsewhere(session):
    """Is it held for a Claude Code opened outside Standby (not "Continue in Claude Code")?"""
    try:
        with open(hold_path(session)) as fh:
            return ELSEWHERE in fh.read().split()
    except (IOError, OSError):
        return False


def standby_made():
    """The conversations Standby made for its sessions on this machine, from its own records
    (agent/<key>.uuid): a voice's (<session>.voice), a copy (its .fork, or its meta says copy),
    or a meeting's own new one. Never the user's own conversation a session was attached to,
    and nothing it can't tell (a session whose meta is gone): those stay offered."""
    out = set()
    for path in glob.glob(os.path.join(AGENT, "*.uuid")):
        key = os.path.basename(path)[:-len(".uuid")]
        try:
            with open(path) as fh:
                sid = fh.read().strip()
        except (IOError, OSError):
            continue
        if not UUID_RE.match(sid):
            continue
        if "." in key or os.path.exists(fork_path(key)):
            out.add(sid)                              # a voice (or another helper), or a copy about to be made
            continue
        meta = session_meta(key)
        a = meta.get("attach") if isinstance(meta.get("attach"), dict) else None
        if a and not a.get("copy") and a.get("from") == sid:
            continue                                  # the user's own, attached: theirs
        if meta:
            out.add(sid)                              # a copy, or the meeting's own new conversation
    return out


def conversation_list(limit=20, skip=()):
    """The user's Claude Code conversations on this machine, newest first, for
    Standby's picker: [{"id", "title", "prompt", "path", "at", "tokens",
    "open"}]. Read from each file's tail, where Claude Code re-appends its title and
    last prompt (2 ms for 33 here). Not Standby's own (its folder's, and the helpers it
    made in the user's folders: an agent's voice, a call's copy), temporary folders,
    folders that are gone, or the ids in `skip` (a live session's)."""
    files = []
    for f in glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl")):
        try:
            files.append((os.path.getmtime(f), f))
        except OSError:
            pass
    agent, opened, mine = os.path.realpath(AGENT), open_conversations(), sbagents.helpers() | standby_made()
    out = []
    for mtime, f in sorted(files, reverse=True):
        sid = os.path.basename(f)[:-len(".jsonl")]
        if not UUID_RE.match(sid) or sid in skip or sid in mine:
            continue
        slot = os.path.basename(os.path.dirname(f))
        path = next((os.path.realpath(c) for c in transcript_cwds(f) if os.path.isdir(c) and _slot_of(slot, c)), None)
        if not path or path == agent or path.startswith(agent + os.sep) or (path + "/").startswith(TEMP_DIRS):
            continue
        facts = _tail_facts(f)
        if facts is None or facts["title"].endswith(VOICE_SUFFIX):     # an agent's voice, made before it was noted
            continue
        # open: where it is open elsewhere, {"where", "busy"}, or None (none seen: a Terminal
        # window may not say).
        out.append(dict(facts, id=sid, path=path, at=round(mtime, 1), open=opened.get(sid)))
        if len(out) >= limit:
            break
    return out


def _tail_facts(path, size=262144):
    """{"title", "prompt", "tokens"} from a transcript's last 256 KB, or None if it
    has no turn there: the newest custom title (the user's /rename), else Claude's own,
    else the last prompt; the last turn's context size."""
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, os.path.getsize(path) - size))
            lines = fh.read().splitlines()
    except (IOError, OSError):
        return None
    custom = ai = prompt = None
    tokens = None
    for line in reversed(lines):
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if not isinstance(r, dict):
            continue
        t = r.get("type")
        if t == "custom-title" and custom is None:
            custom = r.get("customTitle")
        elif t == "ai-title" and ai is None:
            ai = r.get("aiTitle")
        elif t == "last-prompt" and prompt is None:
            prompt = r.get("lastPrompt")
        elif t == "assistant" and tokens is None:
            u = (r.get("message") or {}).get("usage") or {}
            if u:
                tokens = sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens",
                                                          "cache_creation_input_tokens"))
        if custom and ai and prompt and tokens is not None:
            break
    if tokens is None and not prompt:
        return None
    clip = lambda x: " ".join(str(x or "").split())[:120]
    return {"title": clip(custom or ai or prompt), "prompt": clip(prompt), "tokens": tokens or 0}


def _b64(value):
    try:
        return base64.b64decode(value).decode("utf-8")
    except (ValueError, TypeError):
        return None


def cmd_deliver(args):
    """A message to one conversation, as JSON (sbagents.deliver): {"delivery", "msg_id"?,
    "open_in"?, "error"?}. The text comes base64, so any text survives ssh's quoting."""
    text = _b64(args.text)
    if not UUID_RE.match(args.id or "") or text is None:
        print(json.dumps({"delivery": "failed", "error": "bad request"}))
        return 1
    folder = _b64(args.folder) if args.folder else None
    print(json.dumps(sbagents.deliver(args.id, text, folder, _find_claude(), os.path.realpath(__file__),
                                      REGISTRY, model=args.model)))
    return 0


def cmd_deliver_run(args):
    """The outbox's runner: Standby's turns for one conversation, one at a time."""
    if not UUID_RE.match(args.id or ""):
        return 1
    return sbagents.run_outbox(args.id, _find_claude(), REGISTRY)


def cmd_delete_agent(args):
    """A conversation Standby started, deleted for good, as JSON (sbagents.delete)."""
    if not UUID_RE.match(args.id or ""):
        print(json.dumps({"error": "bad request"}))
        return 1
    print(json.dumps(sbagents.delete(args.id, REGISTRY)))
    return 0


def cmd_open_where(args):
    """Is one conversation open in another Claude Code, now, as JSON: {"open":
    {"where", "busy", "name"} or null}. Only the registry: cheap enough to ask every
    second while the start window waits for it to close."""
    print(json.dumps({"open": open_conversations().get(args.id)}))
    return 0


def cmd_conversations(args):
    """The user's Claude Code conversations, as JSON, for the app's picker. Not
    the one the live session is on, which a second session must not share."""
    live = current_session()
    skip = {session_uuid(live, create=False)[0]} if live != "none" else set()
    print(json.dumps({"conversations": conversation_list(args.limit, skip=skip - {None})}))
    return 0


def forget_session(session):
    """Drop a conversation id that turned out not to exist."""
    try:
        os.remove(uuid_path(session))
        return True
    except OSError:
        return False


def session_meta(session):
    path = os.path.join(LIVE, session + ".meta.json")
    try:
        with open(path) as fh:
            meta = json.load(fh)
    except (IOError, ValueError):
        return {}
    return meta if isinstance(meta, dict) else {}


def workspace_for(session):
    """The directory the agent works in. A conversation already under way: the
    folder it lives in, whatever the session or the settings say now, since
    Claude Code resumes it only from there. A new one: the session's
    --workspace if it is a real directory on this machine, else the neutral
    agent dir."""
    wanted = session_meta(session).get("workspace")
    path = os.path.realpath(os.path.expanduser(wanted)) if wanted else None
    lives = conversation_dir(session_uuid(session, create=False)[0], also=(path, AGENT))
    if lives:
        return lives
    if path and os.path.isdir(path):
        return path
    if wanted:
        sys.stderr.write("standby-agent: workspace %r not found on this machine, "
                         "using %s\n" % (wanted, AGENT))
    return AGENT


def holds_home(path):
    """Is `path` the home folder, or a folder above it? Claude Code started in one reads into the
    folders macOS guards there (Desktop, Documents, Downloads) as it starts, and macOS then asks the
    user, in Standby's name, with the call waiting on it (measured, 2026-10-27)."""
    if not path:
        return False
    home, p = os.path.realpath(os.path.expanduser("~")), os.path.realpath(path)
    return p == home or home.startswith(p.rstrip(os.sep) + os.sep)


def start_dir(cwd, argv):
    """Where a Claude Code of this agent's starts: `cwd`, unless that holds the home folder, then the
    neutral agent dir. What it reads stays the same (its --add-dir folders and the fence). Claude Code
    resumes a conversation only from its own folder's slot, so the one argv resumes is copied there:
    a fork's source afresh each time (never an earlier call's copy), the agent's own conversation once.
    Nothing is ever written back into the user's slot."""
    if not holds_home(cwd):
        return cwd
    if "--resume" in argv[:-1]:
        sid = argv[argv.index("--resume") + 1]
        slot = os.path.expanduser("~/.claude/projects/" + project_slot(AGENT))
        mine = os.path.join(slot, "%s.jsonl" % sid)
        fresh = "--fork-session" in argv
        for path in glob.glob(os.path.expanduser("~/.claude/projects/*/%s.jsonl" % sid)):
            if os.path.dirname(path) != slot and (fresh or not os.path.exists(mine)):
                try:
                    os.makedirs(slot, exist_ok=True)
                    shutil.copyfile(path, mine + ".part")
                    os.replace(mine + ".part", mine)
                except OSError as exc:
                    sys.stderr.write("standby-agent: couldn't copy conversation %s to %s: %s\n" % (sid, slot, exc))
                break
    os.makedirs(AGENT, exist_ok=True)
    return AGENT


def project_slot(path):
    """Where Claude Code keeps a working dir's conversations, under
    ~/.claude/projects: its real path with every non-alphanumeric as "-" (past
    200 characters, cut there and a hash added)."""
    return re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(path))


def _slot_of(slot, path):
    name = project_slot(path)
    return slot == name or (len(name) > 200 and slot.startswith(name[:200] + "-"))


def transcript_cwds(path, tail=262144, head=65536):
    """The working dirs a Claude Code transcript names, newest first: from its
    end, then its start (a session moved with /cd names its old one at the start)."""
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - tail))
            end = fh.read()
            fh.seek(0)
            start = fh.read(head)
    except (IOError, OSError):
        return []
    out = []
    for chunk, newest_first in ((end, True), (start, False)):
        lines = chunk.decode("utf-8", "replace").splitlines()
        for line in reversed(lines) if newest_first else lines:
            if '"cwd"' not in line:
                continue
            try:
                cwd = json.loads(line).get("cwd")
            except (ValueError, AttributeError):
                continue
            if isinstance(cwd, str) and cwd not in out:
                out.append(cwd)
    return out


def conversation_dir(sid, also=()):
    """The folder a Claude Code conversation lives in: the one whose slot holds
    its transcript, from the cwd the transcript names (or one of `also`). None
    when nothing has been said in it yet, or the folder is gone."""
    if not sid:
        return None
    for path in glob.glob(os.path.expanduser("~/.claude/projects/*/%s.jsonl" % sid)):
        slot = os.path.basename(os.path.dirname(path))
        for cwd in transcript_cwds(path) + [a for a in also if a]:
            if os.path.isdir(cwd) and _slot_of(slot, cwd):
                return os.path.realpath(cwd)
    return None


CUSTOM_PROMPT = os.path.join(ROOT, "prompt.md")


def default_prompt():
    """The built-in instructions, with {session} and {workspace} left in."""
    return PRELUDE.format(session="{session}", workspace="{workspace}")


def prompt_template():
    """The user's edited instructions (from the app) if any, else the default."""
    try:
        with open(CUSTOM_PROMPT) as fh:
            text = fh.read()
        if text.strip():
            return text, True
    except IOError:
        pass
    return default_prompt(), False


STANDBY_TAGS = ("[TRANSCRIPT]", "[QUESTION]", "[VOICE]")   # how every turn Standby sends begins

# An attached session runs on one of the user's own conversations, which began
# without Standby's instructions. Claude Code keeps the system prompt a conversation
# started with when it is resumed or forked, and --append-system-prompt then does
# nothing (measured on 2.1.296, a rule followed fresh and not after a resume, a fork
# or a resume in stream-json). So the instructions go in its first turn instead,
# marked as Standby's; again only if they change (the user edits them in the app),
# from the next start of its Claude Code, as "Changes apply from the next session".
# Scoped to Standby's own turns: the user goes on in that conversation in Claude Code
# later, and there it is normal work (measured: no rule, no SUGGEST line there).

RULES_TURN = ("[STANDBY RULES]\n"
              "Standby, the user's meeting companion on their Mac, has joined this conversation to a "
              "session. These are Standby's instructions for it, from the user's own Standby app, not from "
              "anyone in a meeting. They apply only to Standby's own messages: the ones that begin with "
              + ", ".join(STANDBY_TAGS) + ". Follow them for those, as you would a system prompt. "
              "Anything else in this conversation was typed by the user directly in Claude Code: answer "
              "it as normal work, as if these instructions weren't here (no listening rules, no SUGGEST "
              "lines; do what they ask).\n\n"
              "%s\n[/STANDBY RULES]")


def rules_path(session):
    return os.path.join(AGENT, "%s.rules" % session)


def rules_owed(session, sid):
    """For an attached session's conversation still without Standby's instructions
    (or with an older version of them): (the text, the mark that says it went), else
    None. A session of Standby's own has them as its system prompt."""
    if not attached(session) or not sid:
        return None
    import hashlib
    text = system_prompt(session)
    mark = "%s %s" % (sid, hashlib.sha1(text.encode("utf-8")).hexdigest()[:12])
    try:
        with open(rules_path(session)) as fh:
            if fh.read().strip() == mark:
                return None
    except (IOError, OSError):
        pass
    return text, mark


def system_prompt(session):
    ws = workspace_for(session)
    text = TALK_PRELUDE if is_talk(session) else prompt_template()[0]
    return (text.replace("{session}", session)
            .replace("{workspace}", ws if ws != AGENT else "(none: skills and notes only)"))


# ------------------------------------------------------------------ talks
#
# A talk is a session without a meeting: the user talks with Claude, out
# loud or typing, and nothing is recorded but their turns. The same two Claude
# Codes and the same tools as a meeting. What differs is all here: the prompts,
# no listening and no briefing (there is no transcript), and questions that
# name their session, since an ended talk is continued by typing, with no
# recorder and nothing live.

TALK_PRELUDE = """You are Standby: the user's assistant on their Mac, in a talk session.
There is no meeting: the user is talking with you directly, out loud or typing.

Session: {session}
Workspace: {workspace}

You will receive two kinds of messages.

1. QUESTION messages, typed by the user:

   [QUESTION]
   <what they typed>

2. VOICE messages, spoken by the user and handed to you by the quick voice that
   talks with them, when a good answer needs real work. They carry their own
   rules for the reply, because the reply is read aloud. Otherwise treat them
   as QUESTION messages.

- Lead with the answer. A quick question gets a short one; a request to find,
  investigate, fix or draft something gets the work done properly. The user
  sees your progress live, so there is no rush, and no padding.
- You have the user's own Claude Code tools: their MCP servers, plugins and
  skills, the web and the workspace. Use whatever a good answer needs.
- Spoken words are machine speech-to-text: fix misheard words from context.
- If you are not sure, say "not sure" in the first three words.
- End every answer with up to 3 lines "SUGGEST: <question>": what the user is
  most likely to ask next about this answer, at most 8 words each, phrased the
  way the user would ask it, in the language of the conversation, specific,
  never one already asked, no filler. None if nothing natural follows. They
  show as buttons; never mention them.
- Never send, post, comment, create, delete or change anything (email, chats,
  tickets, code reviews, files) unless the user asked for exactly that in this
  conversation. When they did, do it and say what you did.
"""

def is_talk(session):
    return session_meta(session).get("kind") == "talk"


def voice_prelude(session, ledger=False):
    """A call's voice's system prompt: the same for every call from one folder, so Claude Code's prompt
    cache serves the next call's first turn warm. What belongs to this call (its session, what the
    session has been working on) comes with its first turn instead (call_opening)."""
    meta = voice_meta(session)              # a call from the user's Claude Code session: the only voice
    folder = meta.get("folder")
    return (CALL_LEDGER_PRELUDE if ledger else CALL_VOICE_PRELUDE).replace("{folder}", " in %s" % folder if isinstance(folder, str) and folder.strip() else "")


def call_opening(session):
    """What the call's first turn ([CALL START]) carries before anything else: this call's session, and
    what the session has been working on, as information."""
    meta = voice_meta(session)
    out = "Session: %s" % session
    gist = meta.get("gist")
    if isinstance(gist, str) and gist.strip():
        at = meta.get("gist_at")
        when = time.strftime(" (as of %H:%M)", time.localtime(at)) if isinstance(at, (int, float)) else ""
        if meta.get("gist_stale"):                 # made before the session's latest work
            when = (when[:-1] + ", " if when else " (") + "before its latest work, so some of it may be done)"
        out += "\n[SUMMARY] What this session has been working on%s:\n%s\n[END SUMMARY]" % (
            when, gist.strip()[:VOICE_GIST_CHARS])
    return out


# A call's voice: one conversation per Claude Code session, carried from call to call. The Mac
# writes live/<session>.voice.json, {"from": <the voice's conversation now, or null for a first
# call>, "name": "Claude Code · voice", "handoff": true, "folder", "gist"}, before voice mode starts.
# Each call's voice is a fork of it (one writer: a call that fails never harms the voice), and
# the Mac moves the agent's voice to that fork when the call ends.
VOICE_GIST_CHARS = 8000           # up to 1000 words: what a call's Claude Code session has been working on
VOICE_SUFFIX = " · voice"         # how an agent's voice is named ("Planner · voice"): never an agent itself
VOICE_COMPACT = "100k"            # Claude Code's lowest auto-compact window: the voice stays small


def voice_meta(session):
    path = os.path.join(LIVE, session + ".voice.json")
    try:
        with open(path) as fh:
            meta = json.load(fh)
    except (IOError, OSError, ValueError):
        return {}
    return meta if isinstance(meta, dict) else {}


def voice_from(session):
    """The voice conversation this call's voice forks from, if it is there to fork."""
    src = voice_meta(session).get("from")
    if isinstance(src, str) and UUID_RE.match(src) and \
            glob.glob(os.path.expanduser("~/.claude/projects/*/%s.jsonl" % src)):
        return src
    return None


def listens(session):
    """Is this session's transcript pushed to the agent while nobody asks?
    A meeting's is. A talk has none: everything said there is a turn. (A browser session,
    from when Standby had a browser, has none either.)"""
    return session_meta(session).get("kind") not in ("talk", "browser")


ASKED_FOR = ".s"    # beside a queued question: the session it is for, when not the live one


def asked_session(ident):
    """The session a queued question named (`q --session`), or None: the live one."""
    path = os.path.join(SPOOL, ident + ASKED_FOR)
    try:
        with open(path) as fh:
            name = fh.read().strip()
        os.remove(path)
    except (IOError, OSError):
        return None
    return session_name(name) if name != "none" else None


# ------------------------------------------------------------------ project folders
#
# the folder Claude Code works in, picked per session. These run where the
# agent runs (this Mac, or the SSH host), so the folders are that machine's.

TEMP_DIRS = tuple(os.environ.get("STANDBY_TEMP_DIRS", "/private/var/folders/:/var/folders/:/private/tmp/:/tmp/")
                  .split(":"))                            # not projects (the tests set their own)
MAX_PROJECTS = 12


def folder_facts(path):
    """A folder as the app shows it: its absolute path (~ expanded, links
    resolved), whether it is there, and whether it has a CLAUDE.md."""
    full = os.path.realpath(os.path.expanduser(path)) if path else ""
    exists = bool(full) and os.path.isdir(full)
    claude_md = exists and any(os.path.isfile(os.path.join(full, *p)) for p in (("CLAUDE.md",), (".claude", "CLAUDE.md")))
    return {"path": full, "exists": exists, "claude_md": bool(claude_md)}


def recent_projects(limit=MAX_PROJECTS):
    """The folders Claude Code has worked in on this machine, newest first, each
    from the cwd its newest transcript names (the names under ~/.claude/projects
    can't be read back: every non-alphanumeric became "-"). Not Standby's own
    folder, temporary ones, ones that are gone, or slots with no conversation
    (some hold only memory)."""
    agent, found = os.path.realpath(AGENT), {}
    for slot_dir in glob.glob(os.path.expanduser("~/.claude/projects/*/")):
        slot = os.path.basename(os.path.normpath(slot_dir))
        files = []
        for f in glob.glob(os.path.join(slot_dir, "*.jsonl")):
            try:
                files.append((os.path.getmtime(f), f))
            except OSError:
                pass
        path = at = None
        for mtime, f in sorted(files, reverse=True)[:3]:
            path = next((os.path.realpath(c) for c in transcript_cwds(f) if os.path.isdir(c) and _slot_of(slot, c)), None)
            if path:
                at = mtime
                break
        if not path or path == agent or path.startswith(agent + os.sep) or (path + "/").startswith(TEMP_DIRS):
            continue
        if path not in found or at > found[path]["at"]:
            found[path] = dict(folder_facts(path), at=round(at, 1))
    return sorted(found.values(), key=lambda p: -p["at"])[:limit]


def cmd_where(args):
    """Where this session's conversation lives, as JSON, for the app's folder chip:
    the folder Claude Code keeps it under, which a /cd in Claude Code moves.
    "own" says it is Standby's own neutral folder, which is not a project. Read
    only: it never mints a conversation id."""
    session = args.session or current_session()
    path = workspace_for(session) if session != "none" else AGENT
    print(json.dumps({"path": path, "own": os.path.realpath(path) == os.path.realpath(AGENT)}))
    return 0


def cmd_projects(args):
    """Recent project folders and the default one, as JSON, for the app's picker."""
    print(json.dumps({"projects": recent_projects(max(1, min(int(getattr(args, "limit", 0) or MAX_PROJECTS), 200))),
                      "default": folder_facts(args.default)["path"]}))
    return 0


def plugin_version(root=None):
    """A hash of the agent's own files (plugin/, as installed), so the app can tell
    an agent on a host that is older than its own. Same on the Mac's copy."""
    import hashlib
    root = root or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    h = hashlib.sha1()
    for d, dirs, files in sorted(os.walk(root)):
        dirs[:] = sorted(x for x in dirs if x != "__pycache__")
        for name in sorted(files):
            if name.endswith((".pyc", ".pyo")) or name.startswith("."):
                continue
            full = os.path.join(d, name)
            try:
                with open(full, "rb") as fh:
                    data = fh.read()
            except (IOError, OSError):
                continue
            h.update(os.path.relpath(full, root).replace(os.sep, "/").encode() + b"\0" + data + b"\0")
    return h.hexdigest()[:16]


def cmd_version(args):
    """The agent's version, as JSON: a hash of its own files (plugin_version)."""
    print(json.dumps({"version": plugin_version()}))
    return 0


def cmd_check_folder(args):
    """One folder's facts, as JSON: is it there, and does it have a CLAUDE.md."""
    print(json.dumps(folder_facts(args.path)))
    return 0


def cmd_resume_cmd(args):
    """Where and how to continue this session's conversation in Claude Code
    itself, as JSON: the conversation id, its working dir, the claude binary,
    and "command", the shell line that opens it (on this machine) under
    `hold`, so the meeting agent stays off the conversation meanwhile."""
    session = args.session or current_session()
    if session == "none":
        print(json.dumps({"error": "No session to continue."}))
        return 1
    # Nothing said in it yet: the id is made now, `hold` starts the
    # conversation under it, and the meeting agent carries on with it.
    sid = session_uuid(session)[0]
    cwd, claude = workspace_for(session), CLAUDE or "claude"
    command = "cd %s && %s %s hold --session %s -- %s --resume %s" % tuple(
        shlex.quote(x) for x in (cwd, sys.executable or "python3", os.path.abspath(__file__),
                                 session, claude, sid))
    print(json.dumps({"uuid": sid, "cwd": cwd, "claude": claude, "command": command}))
    return 0


# ------------------------------------------------------------------ hold
#
# The meeting's conversation can be continued in Claude Code itself (the app's
# "Continue in Claude Code"), the same conversation, not a copy. Two writers
# on one conversation split it: each continues from its own last message, and
# a later --resume follows only the newest branch, so whatever the other one
# said (transcript included) is gone from view. So it has one owner at a time:
# `hold` runs that Claude Code, and while it does the meeting agent stops its
# process on the conversation, sends no transcript (it waits, unsent) and
# answers no typed question (they wait too). When it quits, the agent resumes
# the conversation from the file, the Terminal's turns included.

HELD_STEP = "Waiting for Claude Code in Terminal to close"
HELD_ANSWER = ("This conversation is open in Claude Code. Close it there, and Standby carries on "
               "with it, the transcript included.")
HELD_VOICE = ("I'd need the meeting agent for that, and it's paused while Claude Code is "
              "open in Terminal. Quit it there, then ask me again.")


def hold_path(session):
    return os.path.join(AGENT, "%s.hold" % session)


def _remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def holder(session):
    """The pid of the `hold` that has this meeting's conversation, or None.
    One that died without cleaning up is cleaned up here."""
    path = hold_path(session)
    try:
        with open(path) as fh:
            pid = int(fh.read().split()[0])
    except (IOError, OSError, ValueError, IndexError):
        return None
    try:
        os.kill(pid, 0)
        return pid
    except OSError:
        _remove(path)
        _remove(path + ".ack")
        return None


def hold_acked(session, pid):
    """Has the serving agent let go of the conversation for this hold?"""
    try:
        with open(hold_path(session) + ".ack") as fh:
            return fh.read().strip() == str(pid)
    except IOError:
        return False


def settle_holds(backend, acked):
    """Serve loop: stop the meeting engine of any newly held conversation, so
    nothing more is written to it, and acknowledge to the hold."""
    # a conversation opened outside Standby is held the same way, checked here
    # four times a second for the live session and every meeting engine running.
    for session in {current_session()} | {k[0] for k in list(_LIVE_SESSION) if k[1] == "meeting"}:
        guard(session)
    try:
        names = [n[:-5] for n in os.listdir(AGENT) if n.endswith(".hold")]
    except OSError:
        names = []
    for session in names:
        pid = holder(session)
        if pid is None or acked.get(session) == pid:
            continue
        with backend.lock:
            engine = _LIVE_SESSION.pop((session, "meeting"), None)
            if engine is not None:
                engine.stop()
        with open(hold_path(session) + ".ack", "w") as fh:
            fh.write("%d\n" % pid)
        acked[session] = pid
        sys.stderr.write("standby-agent: %s is open in Claude Code (pid %d): the meeting agent waits\n"
                         % (session, pid))
        sys.stderr.flush()
    for session in [s for s in acked if s not in names]:
        acked.pop(session)
        sys.stderr.write("standby-agent: %s is back with the meeting agent\n" % session)
        sys.stderr.flush()


def cmd_hold(args):
    """Run a command, Claude Code on this meeting's conversation, holding the
    conversation: see the note above. Exits with the command's status."""
    session = args.session or current_session()
    command = list(args.command or [])
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        die("nothing to run")
    ensure_dirs()
    if holder(session) is not None:
        die("this meeting's conversation is already open in another Claude Code. Quit that one first.")
    path, me = hold_path(session), os.getpid()
    with open(path + ".tmp", "w") as fh:
        fh.write("%d\n" % me)
    os.rename(path + ".tmp", path)
    import signal as _signal
    try:
        # A listen turn stops at once; a question being answered is let finish.
        start, said = time.time(), False
        try:
            while server_pid() is not None and not hold_acked(session, me) and time.time() - start < 60:
                if not said and time.time() - start > 1:
                    print("Waiting for Standby's agent to finish its answer...", flush=True)
                    said = True
                time.sleep(0.1)
        except KeyboardInterrupt:
            return 130
        command = start_if_new(command, session)
        # Ctrl-C belongs to Claude Code. A handler, not SIG_IGN: the child would inherit that.
        _signal.signal(_signal.SIGINT, lambda *_a: None)
        try:
            child = subprocess.Popen(command)
        except OSError as exc:
            die("could not run %s: %s" % (command[0], exc))

        def _pass(signum, _frame):          # a closing window, or a kill: Claude Code too
            try:
                child.send_signal(signum)
            except OSError:
                pass
        _signal.signal(_signal.SIGTERM, _pass)
        _signal.signal(_signal.SIGHUP, _pass)
        return child.wait()
    finally:
        if holder(session) == me:
            _remove(path)
            _remove(path + ".ack")


def start_if_new(command, session=None):
    """`--resume ID` for a conversation nothing was said in yet is
    `--session-id ID`: Claude Code starts it under that id. Decided here, once
    the meeting agent has let go, since its first turn may have just started it.
    A copy of one of the user's conversations not made yet is made now:
    `--resume THEIRS --fork-session --session-id ID`."""
    if "--resume" in command[:-1]:
        i = command.index("--resume")
        if not glob.glob(os.path.expanduser("~/.claude/projects/*/%s.jsonl" % command[i + 1])):
            source = fork_of(session) if session else None
            new = ["--resume", source, "--fork-session", "--session-id"] if source else ["--session-id"]
            command = command[:i] + new + command[i + 1:]
    return command


def cmd_held(args):
    """Exit 0 (printing the pid) while the session's conversation is held."""
    session = args.session or current_session()
    pid = holder(session)
    if pid is None:
        return 1
    where = ""
    if held_elsewhere(session):                   # opened outside Standby; and where
        entry = next((e for e in running_claudes() if e["pid"] == pid), None)
        where = " elsewhere " + (opened_where(entry)["where"] if entry else "another app")
    print("%d%s" % (pid, where.rstrip()))
    return 0


def cmd_copy(args):
    """Use a copy: a session waiting for its conversation to close in another
    Claude Code goes on with a copy of it instead, made at its next turn (as an attached session's
    copy is), and that window keeps the original. Only while it waits: then nothing
    of Standby's is in the conversation since it was held."""
    session = args.session
    attach = attached(session)
    if not attach:
        die("this session isn't on one of your conversations")
    if attach["copy"]:
        print(json.dumps({"ok": True}))
        return 0
    if not (held_elsewhere(session) or open_elsewhere(attach["from"])):
        die("its conversation isn't open anywhere else: nothing to copy around")
    ensure_dirs()
    with open(fork_path(session), "w") as fh:
        fh.write(attach["from"] + "\n")
    new = str(uuid.uuid4())
    with open(uuid_path(session) + ".tmp", "w") as fh:
        fh.write(new + "\n")
    os.rename(uuid_path(session) + ".tmp", uuid_path(session))
    meta = session_meta(session)
    if isinstance(meta.get("attach"), dict):
        meta["attach"] = dict(meta["attach"], copy=True)
        path = os.path.join(LIVE, session + ".meta.json")
        with open(path + ".tmp", "w") as fh:
            json.dump(meta, fh)
        os.rename(path + ".tmp", path)
    _remove(hold_path(session))                   # the copy is no one else's: the guard lets it go
    _remove(hold_path(session) + ".ack")
    print(json.dumps({"ok": True}))
    return 0


def cmd_prompt(args):
    text, custom = prompt_template()
    print(json.dumps({"prompt": text, "custom": custom, "default": default_prompt()}))
    return 0


_CAPS = {}


def claude_caps():
    """What this Claude Code accepts, read once from its --help: builds differ."""
    if not _CAPS:
        try:
            text = subprocess.run([CLAUDE, "--help"], stdin=subprocess.DEVNULL, capture_output=True,
                                  text=True, timeout=20).stdout
        except (OSError, subprocess.SubprocessError):
            text = ""
        mode = "--permission-mode" in text
        _CAPS.update(auto=mode and '"auto"' in text, dont_ask=mode and '"dontAsk"' in text,
                     prompts="--permission-prompts" in text, no_persist="--no-session-persistence" in text,
                     bare="--bare" in text, settings="--settings" in text, autocompact="--autocompact" in text, name="--name" in text)
    return _CAPS


# Voice mode's engine runs --bare (measured). Claude
# Code otherwise attaches ~5.5k tokens of context (CLAUDE.md and rules, auto-memory,
# plugin hooks) to the newest message only, so each turn missed the prompt cache after
# the system prompt and paid for the whole conversation again. --bare reads neither the
# keychain nor a /login, so only where Claude Code signs in without them: Vertex,
# an API key. Not again in this run once it failed to sign in so.
NO_BARE = []
BARE_SIGNIN = ("CLAUDE_CODE_USE_VERTEX", "ANTHROPIC_API_KEY")
BARE_REFUSED = ("api key", "/login", "not logged in", "authentication", "credit balance", "oauth")


def voice_bare():
    """Does voice mode's engine run --bare here (see above)?"""
    if NO_BARE or os.environ.get("STANDBY_VOICE_BARE") == "0" or not claude_caps().get("bare"):
        return False
    env = {}
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as fh:
            env = (json.load(fh) or {}).get("env") or {}
    except (IOError, OSError, ValueError, AttributeError):
        pass
    env = dict(env, **os.environ)
    return any(str(env.get(k) or "").strip().lower() not in ("", "0", "false") for k in BARE_SIGNIN)


# A model this Claude Code may not use is not refused: it runs another in its
# place, silently (measured: haiku ran Opus 5.5 with 1M context, the slowest).
# What it really runs is in each process's init message; a model it replaced is
# never asked for again here, Sonnet is, until it is checked again a week on.
MODELS = os.path.join(AGENT, "models.json")
IN_ITS_PLACE = "sonnet"
RECHECK = 7 * 86400
_MODELS_LOCK = threading.Lock()
SLOW_WORD = 8.0                  # a first word later than this is logged with what came before it
_REPLACED = set()                # this run's, should models.json not be writable


def model_family(name):
    name = str(name or "").lower()
    return next((f for f in ("haiku", "sonnet", "opus") if f in name), name)


def models_seen():
    try:
        with open(MODELS) as fh:
            data = json.load(fh)
    except (IOError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def model_for(asked):
    """What to ask Claude Code for: the model chosen, or Sonnet in its place
    when this Claude Code was seen running another model for it."""
    seen = models_seen().get(asked)
    replaced = asked in _REPLACED or (isinstance(seen, dict) and seen.get("blocked")
                                      and time.time() - seen.get("at", 0) < RECHECK)
    return IN_ITS_PLACE if replaced and model_family(asked) != IN_ITS_PLACE else asked


def note_model(asked, runs):
    """Claude Code said it runs `runs` for `asked`: kept in models.json (the
    app reads it to mark a model not available). True when it is another."""
    blocked = model_family(runs) != model_family(asked)
    with _MODELS_LOCK:
        (_REPLACED.add if blocked else _REPLACED.discard)(asked)
        data = models_seen()
        was = data.get(asked) if isinstance(data.get(asked), dict) else {}
        if (was.get("runs"), bool(was.get("blocked"))) != (runs, blocked) or time.time() - was.get("at", 0) > RECHECK:
            data[asked] = {"runs": runs, "blocked": blocked, "at": int(time.time())}
            try:
                ensure_dirs()
                with open(MODELS + ".tmp", "w") as fh:
                    json.dump(data, fh, indent=1, sort_keys=True)
                os.replace(MODELS + ".tmp", MODELS)
            except (IOError, OSError) as exc:
                sys.stderr.write("standby-agent: could not keep %s: %r\n" % (MODELS, exc))
    return blocked


# The voice's model, as Settings has it now: a change during a call reaches the call's next turn
# (ClaudeSession.switch), never a restart. switch.json says how the last switch went, for Settings.
SWITCH = os.path.join(AGENT, "switch.json")


def live_voice_model(started_with):
    """Settings' voice model (config.json, agent.voice_model), else the one this agent started with."""
    try:
        with open(os.path.join(ROOT, "config.json")) as fh:
            chosen = ((json.load(fh) or {}).get("agent") or {}).get("voice_model")
    except (IOError, OSError, ValueError, AttributeError):
        chosen = None
    return chosen if sbagents.valid_model(chosen) else started_with


def note_switch(session, wanted, was, error=None):
    """How a switch went: {session, wanted, was, ok, error, at}. Settings shows it while the call runs."""
    try:
        ensure_dirs()
        with open(SWITCH + ".tmp", "w") as fh:
            json.dump({"session": session, "wanted": wanted, "was": was, "ok": error is None,
                       "error": error, "at": int(time.time())}, fh)
        os.replace(SWITCH + ".tmp", SWITCH)
    except (IOError, OSError) as exc:
        sys.stderr.write("standby-agent: could not keep %s: %r\n" % (SWITCH, exc))


# Usage: a row per Claude Code turn, from its own replies. Its modelUsage
# is a running total for the conversation (its schema says so; a resumed one
# carries on from the total its transcript saved), so a row keeps this turn's
# share. Kept 90 days; the app sums it up (sbusage).
USAGE = os.path.join(AGENT, "usage.jsonl")
KEEP_DAYS = 90
_USAGE_LOCK = threading.Lock()
_PRUNED = [0.0]


# The meeting agent's calls in the last minute, against its budget: a line in the agent's
# log per call, so a meeting's rate can be read off as it goes. Counted when the turn goes
# to Claude Code, so an interrupted turn counts too: it was a call.
_MEETING_CALLS = []
_MEETING_CALLS_LOCK = threading.Lock()


def count_meeting_call(label, now=None):
    """Note one meeting agent call (label: listen, question, deep, voice); its count in
    the last 60 s, logged with the budget."""
    now = time.time() if now is None else now
    with _MEETING_CALLS_LOCK:
        _MEETING_CALLS[:] = [t for t in _MEETING_CALLS if now - t < 60] + [now]
        n = len(_MEETING_CALLS)
    sys.stderr.write("meeting agent: %s, %d call%s in the last minute (budget %d)%s\n" % (
        label, n, "" if n == 1 else "s", MEETING_BUDGET, "  OVER BUDGET" if n > MEETING_BUDGET else ""))
    sys.stderr.flush()
    return n


def usage_share(now, before):
    """This turn's share of the running totals `now` (a modelUsage), counted to
    `before`. A model's total that went down started again: all of it is new."""
    share = {}
    for model, u in (now or {}).items():
        if not isinstance(u, dict):
            continue
        b = (before or {}).get(model) or {}
        again = any((u.get(k) or 0) < (b.get(k) or 0) for k, _n in USAGE_FIELDS)
        row = {}
        for k, name in USAGE_FIELDS:
            v = (u.get(k) or 0) - (0 if again else (b.get(k) or 0))
            row[name] = round(v, 6) if name == "cost_usd" else int(v)
        if any(row.values()):
            share[model] = row
    return share


def record_usage(session, kind, engine, seconds, models):
    """One turn's row in usage.jsonl ("t" first: `usage` reads it without parsing the rest)."""
    if not models:
        return
    row = {"t": int(time.time()), "session": session, "kind": kind, "engine": engine,
           "seconds": round(seconds or 0, 1), "models": models}
    with _USAGE_LOCK:
        try:
            ensure_dirs()
            with open(USAGE, "a") as fh:
                fh.write(json.dumps(row) + "\n")
            if time.time() - _PRUNED[0] > 86400:
                prune_usage()
        except (IOError, OSError) as exc:
            sys.stderr.write("standby-agent: could not keep usage: %r\n" % exc)


def prune_usage(now=None):
    """Rows older than KEEP_DAYS go, once a day at most (the oldest is first)."""
    now = now or time.time()
    _PRUNED[0] = now
    cut = now - KEEP_DAYS * 86400
    try:
        with open(USAGE) as fh:
            first = _row_time(fh.readline())
            if first is None or first >= cut:
                return
            fh.seek(0)
            kept = [l for l in fh if (_row_time(l) or 0) >= cut]
        with open(USAGE + ".tmp", "w") as out:
            out.writelines(kept)
        os.replace(USAGE + ".tmp", USAGE)
    except (IOError, OSError):
        pass


def voice_settings(folder):
    """The voice runs with no plugin of the user's and no hooks: a plugin's mod would give it
    tools that act on the voice's own session (Standby's own, run in the project the user
    calls from: "end_call" ending nothing), and its skills point at those tools. Every plugin
    the user, the project or the folder's local settings enable is turned off for it;
    Claude Code's built-ins and the user's own skills stay."""
    paths = [os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "settings.json")]
    if folder:
        paths += [os.path.join(folder, ".claude", "settings.json"), os.path.join(folder, ".claude", "settings.local.json")]
    off = {}
    for path in paths:
        try:
            with open(path) as fh:
                enabled = (json.load(fh) or {}).get("enabledPlugins") or {}
        except (IOError, OSError, ValueError, AttributeError):
            continue
        if isinstance(enabled, dict):
            off.update((key, False) for key in enabled if isinstance(key, str))
    return {"disableAllHooks": True, "enabledPlugins": off}


# What macOS guards for the user (Contacts, Calendars, Photos, iCloud and OneDrive files, Desktop,
# Documents, Downloads): a file tool walking into it shows the user a prompt in Standby's name, since
# Standby started this Claude (2026-10-23: a call's Grep over the whole home folder asked for Contacts
# and OneDrive). The Claude Code that Standby starts reads only its working directories: its folder,
# and Standby's own (~/.standby: its log, the call's transcript); the user's own session, the deeper
# side, reads the rest. And never those folders, unless one of its own is in them.
GUARDED = ("~/Library", "~/Desktop", "~/Documents", "~/Downloads", "~/Pictures", "~/Movies", "~/Music")


REFUSED_FILE = "refused.json"      # in the session's folder: a guarded folder macOS refuses its Claude
NOT_PERMITTED = re.compile(r"operation not permitted", re.I)


def note_refused(session, ev):
    """A tool's read that macOS refused (EPERM) in a folder it guards: noted in the session's folder,
    {"folder": "Desktop", "at": ...}, so the band says so plainly, with the way to allow it. macOS asks
    once; after a Don't Allow nothing else would ever say why the call can't see that project."""
    for block in (ev.get("message") or {}).get("content") or []:
        if not isinstance(block, dict) or block.get("type") != "tool_result":
            continue
        body = block.get("content")
        text = body if isinstance(body, str) else " ".join(
            b.get("text", "") for b in body or [] if isinstance(b, dict))
        if not NOT_PERMITTED.search(text or ""):
            continue
        for g in GUARDED[1:]:                     # not ~/Library: macOS asks nothing for it
            top = os.path.expanduser(g)
            if top + os.sep in text or text.rstrip().endswith(top):
                sdir = os.path.join(ROOT, "sessions", session)
                if os.path.isdir(sdir):
                    tmp = os.path.join(sdir, REFUSED_FILE + ".part")
                    with open(tmp, "w") as fh:
                        json.dump({"folder": os.path.basename(top), "at": time.time()}, fh)
                    os.replace(tmp, os.path.join(sdir, REFUSED_FILE))
                return


IMAGE_RE = re.compile(r"\[IMAGE (/[^\]\n]+)\]")
IMAGE_TYPES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}


def with_images(question):
    """A turn's content: its text, and the images it names ("[IMAGE <path>]", one the user pasted in the
    session's chat, saved with the call) as image blocks after it, so the voice sees what the session sees.
    Only the call's own saved files, at most 4 and 5 MB each."""
    blocks, sessions = [], os.path.realpath(os.path.join(ROOT, "sessions")) + os.sep
    for path in IMAGE_RE.findall(question or "")[:4]:
        real = os.path.realpath(path)
        kind = IMAGE_TYPES.get(os.path.splitext(real)[1].lower())
        try:
            if kind and real.startswith(sessions) and os.path.getsize(real) <= 5 * 1024 * 1024:
                with open(real, "rb") as fh:
                    blocks.append({"type": "image", "source": {"type": "base64", "media_type": kind,
                                                               "data": base64.b64encode(fh.read()).decode("ascii")}})
        except OSError:
            pass
    text = IMAGE_RE.sub("(the image they pasted, below)" if blocks else "", question or "").strip()
    return [{"type": "text", "text": text}] + blocks


def fence(dirs):
    """The permissions that keep a Claude Code to `dirs` (its working directories): reads
    elsewhere refused, and Read deny rules on the guarded folders that hold none of them."""
    real = [os.path.realpath(os.path.expanduser(d)) for d in dirs if d]
    deny = []
    for g in GUARDED:
        top = os.path.realpath(os.path.expanduser(g))
        if not any(d == top or d.startswith(top + os.sep) for d in real):
            deny.append("Read(%s/**)" % g)
    return {"blockReadsOutsideWorkingDirectories": True, "deny": deny}


def voice_dirs(session):
    """The folders a call's voice reads besides its own (voice.json "dirs": where its session works)."""
    meta = voice_meta(session)
    return [d for d in (meta.get("dirs") or []) if isinstance(d, str) and os.path.isdir(d)] if meta else []


def voice_shape(session):
    """What a call's voice process is started with that the call itself decides, once its voice.json is
    written: whether it's a call's (its prompt, skills, folder; else a bare voice) and the folders it reads.
    A process warmed up before that (talk-20261025-010306: bare, no skills, no folders) isn't the call's."""
    return (bool(voice_meta(session)), tuple(voice_dirs(session)))


def build_argv(session, model, fresh, sid, stream, kind="meeting", turn=False, parent=None):
    """The user's own Claude Code: their MCP servers, plugins and settings, so
    the meeting agent can do what they can (measured: 172 tools, and the first
    word as quick as with 5, since Claude Code loads tool details on demand).
    Headless, nobody can approve anything by hand: auto mode's safety check
    decides, or else only pre-approved tools run."""
    caps = claude_caps()
    agent_voice = kind == "voice" and bool(voice_meta(session))
    if kind == "voice":
        # Speed first: no MCP servers, only the transcript and the notes. An agent's voice
        # keeps its skills (they load once per process, not per turn) and stays small.
        tools = "Bash,Read,Grep,Skill" if agent_voice else "Bash,Read,Grep"
        argv = [CLAUDE, "-p", "--model", model, "--tools", tools,
                "--allowedTools", "Bash(standby-ctx:*)", "Read", "Grep"] + (["Skill"] if agent_voice else []) + \
            ["--strict-mcp-config"]
        if caps["dont_ask"]:
            argv += ["--permission-mode", "dontAsk"]
        if caps["prompts"]:
            argv += ["--permission-prompts", "none"]
        if voice_bare() and not agent_voice:
            argv.append("--bare")
        if agent_voice and caps.get("autocompact") and not turn:
            argv += ["--autocompact", VOICE_COMPACT]
        name = voice_meta(session).get("name") if agent_voice and caps.get("name") else None
        if turn and caps.get("name") and not (isinstance(name, str) and name.strip()):
            name = "Standby call voice"            # named: no title call of Claude Code's own for each turn
        if isinstance(name, str) and name.strip():
            argv += ["-n", name.strip()[:80]]
        folder = workspace_for(session)
        if fresh and voice_from(session):
            folder = conversation_dir(voice_from(session)) or folder    # where the engine starts it
        argv += ["--add-dir", ROOT]
        # a call's voice reads where its session works (the Mac lists those folders: voice.json "dirs"), as
        # the session does; the guarded folders stay closed unless the session works inside one
        dirs = voice_dirs(session)
        for d in dirs:
            argv += ["--add-dir", d]
        if caps.get("settings"):
            argv += ["--settings", json.dumps(dict(voice_settings(workspace_for(session)),
                                                   permissions=fence([folder, ROOT] + dirs)))]
        argv += ["--append-system-prompt", voice_prelude(session, ledger=turn)]
    else:
        argv = [CLAUDE, "-p", "--model", model, "--allowedTools"] + ALLOWED
        if caps["auto"]:
            argv += ["--permission-mode", "auto"]
        elif caps["dont_ask"]:
            argv += ["--permission-mode", "dontAsk"]
        if caps["prompts"]:
            argv += ["--permission-prompts", "none"]
        argv += ["--add-dir", os.path.expanduser("~/.claude"), "--add-dir", ROOT]
        if caps.get("settings"):
            argv += ["--settings", json.dumps({"permissions": fence(
                [workspace_for(session), AGENT, ROOT, os.path.expanduser("~/.claude")])})]
        argv += ["--append-system-prompt", system_prompt(session)]
    if stream:
        # Partial messages: the answer arrives word by word, shown live.
        argv += ["--input-format", "stream-json",
                 "--output-format", "stream-json", "--verbose",
                 "--include-partial-messages"]
    else:
        argv += ["--output-format", "text"]
    # Fresh conversation on the first question of a meeting, resume after that,
    # so the brief and earlier answers stay in context. A copy of one of the user's
    # conversations is made at its first turn, under the id chosen for it.
    if turn:                                     # one turn of a call: a fork of its conversation as it stands
        source = parent or (voice_from(session) if agent_voice else None)
        return argv + (["--resume", source, "--fork-session", "--session-id", sid] if source else ["--session-id", sid])
    source = fork_of(session) if kind != "voice" else (voice_from(session) if agent_voice and fresh else None)
    if source:
        argv += ["--resume", source, "--fork-session", "--session-id", sid]
    else:
        argv += (["--session-id", sid] if fresh else ["--resume", sid])
    return argv


# ------------------------------------------------------------------ engines

class ClaudeSession(object):
    """One long-lived headless Claude Code process for the whole meeting."""

    def __init__(self, session, model, kind="meeting"):
        self.session = session
        self.model = model           # the one chosen
        self.asks = model            # the one asked for: Sonnet in place of one not available
        self.runs = None             # the one it really runs, from its init message
        self.kind = kind
        # The voice keeps its own conversation; the meeting's is the one users resume.
        self.key = session if kind == "meeting" else "%s.%s" % (session, kind)
        self.proc = None
        self.buf = b""
        self.logpath = os.path.join(AGENT, "engine.log")
        self.start_at, self.started_at, self.worked = 0, 0.0, False
        self.bare = False            # voice mode's engine started --bare (voice_bare)
        self.refused = None          # a model Claude Code refused to switch to (switch)

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def chosen_model(self):
        """The model to ask for: the one this session's agent was given (the app writes it into
        the session's meta as claude_model, when it starts), else the one the server was started
        with. Only the meeting's engine, the one that does the agent's own work: voice mode keeps
        the voice model."""
        if self.kind == "meeting":
            chosen = session_meta(self.session).get("claude_model")
            if sbagents.valid_model(chosen):
                return chosen
        return self.model

    def start(self):
        if not os.path.exists(CLAUDE):
            raise RuntimeError("no claude binary at %s" % CLAUDE)
        sid, self.fresh = session_uuid(self.key)
        if self.kind == "meeting" and self.fresh and fork_of(self.session):
            sbagents.note_created(sid, "copy")    # a call's or a meeting's copy: Standby's own, never an agent
        if self.kind == "voice" and self.fresh and voice_meta(self.session):
            sbagents.note_created(sid, "voice")   # an agent's voice: Standby's own, to tidy or delete
        # An attached conversation without Standby's instructions gets them in its next
        # turn; edited ones too, from the next start, as a session of its own gets them.
        self.owed = rules_owed(self.session, sid) if self.kind == "meeting" else None
        self.asks, self.runs = model_for(self.chosen_model()), None
        self.sid, self.counted = sid, self._counted(sid)
        argv = build_argv(self.session, self.asks, self.fresh, sid, stream=True, kind=self.kind)
        self.dirs = voice_shape(self.session) if self.kind == "voice" else None    # the call's, as started
        if self.kind == "voice" and sbtrace.enabled(self.session):   # what the voice starts with: the call's trace
            sp = argv[argv.index("--append-system-prompt") + 1] if "--append-system-prompt" in argv else None
            sbtrace.event(self.session, "voice_start", model=self.asks, fresh=bool(self.fresh), system_prompt=sp,
                          tools=argv[argv.index("--tools") + 1] if "--tools" in argv else None)
        self.bare = "--bare" in argv
        # stderr to a file: an unread pipe deadlocks the child.
        self.errfh = open(self.logpath, "ab", 0)
        try:
            self.start_at = os.path.getsize(self.logpath)
        except OSError:
            self.start_at = 0
        self.started_at, self.worked = time.time(), False
        self.errfh.write(("\n=== %s start session=%s (%s) model=%s cwd=%s ===\n"
                          % (time.strftime("%H:%M:%S"), self.session, self.kind, self.asks
                             + ("" if self.asks == self.model else " (%s is not available)" % self.model),
                             workspace_for(self.session))).encode("utf-8"))
        cwd = workspace_for(self.session)
        if self.kind == "voice" and self.fresh and voice_from(self.session):
            cwd = conversation_dir(voice_from(self.session)) or cwd     # a fork resumes only from its folder
        self.proc = subprocess.Popen(argv, stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE,
                                     stderr=self.errfh, cwd=start_dir(cwd, argv))
        self.buf = b""

    def stop(self, hard=False):
        """hard=True is for a blown deadline: the child is wedged mid-turn, so
        kill it now. Waiting politely would add the grace period on top of the
        deadline the user is already out of patience for."""
        if self.proc is None:
            return
        if hard:
            try:
                self.proc.kill()
            except Exception:
                pass
        else:
            try:
                self.proc.stdin.close()
            except Exception:
                pass
            try:
                self.proc.wait(timeout=5)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
        self.proc = None

    TIMEOUT = object()
    EOF = object()

    def _readline(self, deadline):
        """One line from stdout, or TIMEOUT / EOF. The two are different
        failures and deserve different messages."""
        import select
        fd = self.proc.stdout.fileno()
        while True:
            nl = self.buf.find(b"\n")
            if nl >= 0:
                line, self.buf = self.buf[:nl], self.buf[nl + 1:]
                return line
            remaining = deadline - time.time()
            if remaining <= 0:
                return self.TIMEOUT
            ready, _, _ = select.select([fd], [], [], min(remaining, 0.5))
            if not ready:
                continue
            chunk = os.read(fd, 65536)
            if not chunk:
                return self.EOF
            self.buf += chunk

    def _signin_watch(self):
        """What a turn's watch reads from: its own start, or this engine's when it
        started a moment ago and has not answered yet (Claude Code says what is
        wrong with its sign-in as it starts, then only that each call failed)."""
        if not self.worked and time.time() - self.started_at < SIGNIN_FRESH:
            return SigninWatch(self.logpath, self.start_at)
        return SigninWatch(self.logpath)

    def last_log_lines(self, count=3):
        """Tail of the child's stderr, which is where it puts real errors."""
        try:
            with open(self.logpath, "rb") as fh:
                try:
                    fh.seek(-4096, os.SEEK_END)
                except OSError:
                    fh.seek(0)
                lines = [l.strip() for l in
                         fh.read().decode("utf-8", "replace").splitlines()
                         if l.strip() and not l.startswith("===")]
            return " | ".join(lines[-count:])
        except Exception:
            return ""

    SWITCH_WAIT = 5.0     # set_model is answered at once (no API call): this is for a wedged one

    def switch(self, model):
        """Another model for this conversation from its next turn, the process and the conversation as
        they are (Claude Code's set_model): never mid-turn, only between them. Not started yet: it starts
        on it. None when done, else why not (the engine keeps the model it has)."""
        if model == self.model:
            return None
        if not self.alive():
            self.model = model
            return None
        asks = model_for(model)
        if asks == self.asks:
            self.model = model
            return None
        rid = "model-%d" % int(time.time() * 1000)
        req = {"type": "control_request", "request_id": rid, "request": {"subtype": "set_model", "model": asks}}
        try:
            self.proc.stdin.write((json.dumps(req) + "\n").encode("utf-8"))
            self.proc.stdin.flush()
        except Exception as exc:
            return "Claude Code didn't take it (%r)" % exc
        deadline = time.time() + self.SWITCH_WAIT
        while True:
            line = self._readline(deadline)
            if line is self.TIMEOUT or line is self.EOF:
                return "Claude Code didn't answer"
            try:
                ev = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            got = ev.get("response") or {}
            if ev.get("type") != "control_response" or got.get("request_id") != rid:
                continue                          # anything else between turns: nothing waits for it
            if got.get("subtype") == "error":
                return str(got.get("error") or "refused")[:300]
            was, self.model, self.asks, self.runs = self.asks, model, asks, None
            sys.stderr.write("standby-agent: %s engine for %s switched from %s to %s\n" % (self.kind, self.session, was, asks))
            sys.stderr.flush()
            return None

    INTERRUPTED = 2   # rc for a turn stopped on purpose by should_interrupt
    HELD = 3          # rc for a turn not sent: the conversation is open in another Claude Code
    SIGNIN = 4        # rc for a turn ended because Claude Code cannot sign in

    def _counted(self, sid):
        """The conversation's running totals as last counted (a resumed one carries on)."""
        try:
            with open(os.path.join(AGENT, "%s.usage.json" % self.key)) as fh:
                kept = json.load(fh)
            return (kept.get("models") or {}) if kept.get("sid") == sid else {}
        except (IOError, ValueError, AttributeError):
            return {}

    def _count(self, ev, label):
        """A turn's result: its share of the running totals, a row in usage.jsonl."""
        now = ev.get("modelUsage")
        if not isinstance(now, dict):
            return
        share, self.counted = usage_share(now, self.counted), now
        _TOTALS[getattr(self, "sid", None)] = now     # a fork of this conversation carries these on
        self.last_share = share                  # this turn's tokens, for the call's trace
        path = os.path.join(AGENT, "%s.usage.json" % self.key)
        try:
            with open(path + ".tmp", "w") as fh:
                json.dump({"sid": self.sid, "models": now}, fh)
            os.replace(path + ".tmp", path)
        except (IOError, OSError):
            pass
        record_usage(self.session, label or self.kind, self.kind, (ev.get("duration_ms") or 0) / 1000.0, share)

    def _ran(self, runs):
        """Its init message: the model it really runs, logged when it changes.
        True when that is another than asked for, and there is one to ask instead."""
        if runs == self.runs:
            return False
        self.runs = runs
        replaced = note_model(self.asks, runs)
        retry = replaced and model_for(self.asks) != self.asks
        sys.stderr.write("standby-agent: %s engine for %s runs %s%s\n" % (
            self.kind, self.session, runs,
            "" if not replaced else "  (%s is not available here%s)" % (
                self.asks, ": asking for %s instead" % model_for(self.asks) if retry else "")))
        sys.stderr.flush()
        return retry

    def ask(self, question, timeout, _retry=True, should_interrupt=None,
            on_event=None, max_total=None, label=None):
        """Send one turn and wait for its result.

        timeout is an IDLE timeout: the turn is abandoned only after `timeout`
        seconds with no output at all from Claude Code. A turn that keeps
        working (reading files, running tools, writing) is never cut off,
        because real questions can take minutes. The first version used a
        25 s total cap and killed exactly those turns mid-investigation.
        max_total is an optional absolute ceiling (default: none).

        on_event(kind, text) is called for progress: "tool" when the agent
        uses a tool, "delta" for each piece of text as it is written, and
        "text" for each finished block of text.

        should_interrupt: optional callable, polled about every 0.3 s. When it
        returns True, a control_request interrupt is sent; Claude Code stops the
        turn and answers it with an error_during_execution result, measured at
        0.04 s in testing. Used so a question never waits behind a
        background listen turn that is off investigating something.

        label: what the turn is for, in usage.jsonl (listen, question, voice,
        deep, briefing); the engine's kind if none.
        """
        if not self.alive():
            self.start()
        owed, self.owed = getattr(self, "owed", None), None
        if owed is not None:
            question = RULES_TURN % owed[0] + "\n\n" + question
        texts = question if isinstance(question, list) else [question]     # a call's turn: one block per entry
        msg = {"type": "user",
               "message": {"role": "user",       # the images their words name, after the last block (theirs)
                           "content": [{"type": "text", "text": t} for t in texts[:-1]] + with_images(texts[-1])}}
        payload = (json.dumps(msg) + "\n").encode("utf-8")
        try:
            self.proc.stdin.write(payload)
            self.proc.stdin.flush()
        except Exception as exc:
            self.stop()
            self.owed = owed                      # not sent: the next turn carries them
            return "engine write failed (%r), restarting; ask again" % exc, 1
        if on_event is not None:                  # when Claude Code had it, for the voice's timing
            try:
                on_event("sent", "")
            except Exception:
                pass
        if self.kind == "meeting":
            count_meeting_call(label or "question")
        if owed is not None:                      # in the conversation now: not again
            with open(rules_path(self.session), "w") as fh:
                fh.write(owed[1] + "\n")

        started = time.time()
        last_activity = started
        hard_end = started + max_total if max_total else None
        text_parts = []
        interrupted = False
        interrupt_end = None
        early, said = {}, None           # what came before the first word: when first, how many
        watch, produced = self._signin_watch(), [False]

        def notify(kind, text):
            produced[0] = True
            if on_event is not None:
                try:
                    on_event(kind, text)
                except Exception:
                    pass

        while True:
            failed = None if produced[0] else watch.failed(started)
            if failed is not None:
                # Its turn would end in an error ~40 s from now; its next one starts clean.
                self.stop(hard=True)
                return signin_answer(failed), self.SIGNIN
            now = time.time()
            limits = [last_activity + timeout]
            if hard_end:
                limits.append(hard_end)
            if interrupt_end:
                limits.append(interrupt_end)
            deadline = min(limits)
            line = self._readline(min(deadline, now + 0.05))
            if line is self.TIMEOUT and time.time() < deadline:
                if (should_interrupt is not None and not interrupted
                        and should_interrupt()):
                    interrupted = True
                    req = {"type": "control_request",
                           "request_id": "int-%d" % int(time.time() * 1000),
                           "request": {"subtype": "interrupt"}}
                    try:
                        self.proc.stdin.write((json.dumps(req) + "\n").encode("utf-8"))
                        self.proc.stdin.flush()
                    except Exception:
                        pass
                    interrupt_end = time.time() + 10   # bounded window to land
                continue
            if line is self.TIMEOUT:
                self.stop(hard=True)
                if interrupted:
                    return "(interrupted for a question)", self.INTERRUPTED
                idle = time.time() - last_activity
                return ("No activity from the agent for %ds, so it looks stuck and I "
                        "stopped it. The conversation is kept; ask again to continue."
                        % idle), 1
            if line is self.EOF:
                rc = None
                if self.proc is not None:
                    try:
                        rc = self.proc.wait(timeout=2)
                    except Exception:
                        rc = self.proc.poll()
                self.stop(hard=True)
                failed = watch.ended()          # it gave up at once: a sign-in its log names
                if failed is not None and not produced[0]:
                    return signin_answer(failed), self.SIGNIN
                return ("Engine exited (rc=%s). Restarted, ask again. Detail: %s"
                        % (rc, self.logpath)), 1
            last_activity = time.time()
            line = line.strip()
            if not line.startswith(b"{"):
                continue
            try:
                ev = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            kind = ev.get("type")
            if said is None and kind != "result":
                sub = ev.get("subtype") or ((ev.get("event") or {}).get("delta") or {}).get("type") \
                    or (ev.get("event") or {}).get("type")
                tag = "%s/%s" % (kind, sub) if sub else str(kind)
                early.setdefault(tag, [time.time() - started, 0])[1] += 1
            if kind == "system" and ev.get("subtype") == "init" and ev.get("model"):
                if self._ran(ev["model"]) and not interrupted:
                    # Asked for a model it replaced: again, on Sonnet, before it answers.
                    self.stop(hard=True)
                    if self.fresh:
                        forget_session(self.key)
                    return self.ask(question, timeout, _retry=_retry, should_interrupt=should_interrupt,
                                    on_event=on_event, max_total=max_total, label=label)
                continue
            if kind == "assistant":
                for block in ev.get("message", {}).get("content", []):
                    btype = block.get("type")
                    if btype == "text" and block.get("text"):
                        text_parts.append(block["text"])
                        notify("text", block["text"])
                    elif btype == "tool_use":
                        notify("tool", describe_tool(block.get("name"), block.get("input") or {}))
            elif kind == "user":
                note_refused(self.session, ev)
            elif kind == "stream_event":
                delta = (ev.get("event") or {}).get("delta") or {}
                if delta.get("type") == "text_delta" and delta.get("text"):
                    if said is None:
                        said = time.time() - started
                        if said > SLOW_WORD:
                            # Waiting on the API, its retries, or thinking: what the next one shows.
                            sys.stderr.write("standby-agent: %s engine's first word took %.1fs (%s); before it: %s\n" % (
                                self.kind, said, self.runs or self.asks, ", ".join(
                                    "%s %.1fs%s" % (t, at, " x%d" % n if n > 1 else "")
                                    for t, (at, n) in sorted(early.items(), key=lambda x: x[1][0]))))
                            sys.stderr.flush()
                    notify("delta", delta["text"])
            elif kind == "result":
                self._count(ev, label)
                final = ev.get("result")
                if isinstance(final, str) and final.strip():
                    out = final.strip()
                else:
                    out = "\n".join(text_parts).strip()
                if interrupted:
                    return "(interrupted for a question)", self.INTERRUPTED
                if ev.get("is_error"):
                    detail = out or self.last_log_lines() or "unknown"
                    # An orphaned conversation id is recoverable: the id can
                    # outlive (or never have had) a real conversation. Start a
                    # fresh one and retry once rather than failing the question.
                    if _retry and "No conversation found" in detail:
                        forget_session(self.key)
                        self.stop(hard=True)
                        return self.ask(question, timeout, _retry=False,
                                        on_event=on_event, max_total=max_total, label=label)
                    # A bare voice engine that could not sign in that way: as before, from now on.
                    if _retry and self.kind == "voice" and self.bare and any(
                            w in detail.lower() for w in BARE_REFUSED):
                        NO_BARE.append(detail[:200])
                        sys.stderr.write("standby-agent: voice engine: --bare could not sign in (%s): "
                                         "without it from now on\n" % detail[:120])
                        sys.stderr.flush()
                        self.stop(hard=True)
                        return self.ask(question, timeout, _retry=False,
                                        on_event=on_event, max_total=max_total, label=label)
                    if any(m in detail for m in SIGNIN_MARKS):     # "Not logged in · Please run /login"
                        return signin_answer(detail.strip()), self.SIGNIN
                    return "engine error: %s" % detail, 1
                self.worked = True                   # its sign-in is fine: its start's lines no longer count
                return out or "(empty answer)", 0


describe_tool = sbagents.describe_tool   # one short, human line for a tool call


_LIVE_SESSION = {}


class VoiceTurn(ClaudeSession):
    """One turn of a call's voice: a fork of the call's voice conversation as it stands (its head), so the
    conversation so far comes from Claude Code's prompt cache, and its answer stays out of the head until
    the call's record says the turn was committed (an early ask they went on from never is). Started
    ahead as the call's spare, so a turn never waits for one; used for one turn (and its hand-off's task).
    The first turn of a call starts the conversation (or forks the agent's voice from its last call)."""

    def __init__(self, session, model, parent=None):
        ClaudeSession.__init__(self, session, model, "voice")
        self.parent, self.born, self.done = parent, None, threading.Event()

    def start(self):
        if not os.path.exists(CLAUDE):
            raise RuntimeError("no claude binary at %s" % CLAUDE)
        self.sid, self.fresh, self.owed = str(uuid.uuid4()), True, None
        self.asks, self.runs = model_for(self.chosen_model()), None
        self.counted = dict(_TOTALS.get(self.parent) or {}) if self.parent else {}
        argv = build_argv(self.session, self.asks, True, self.sid, stream=True, kind="voice", turn=True,
                          parent=self.parent)
        self.dirs = voice_shape(self.session)
        sbagents.note_created(self.sid, "voice")  # Standby's own: the forks that aren't kept are deleted
        self.bare = "--bare" in argv
        if sbtrace.enabled(self.session):
            sp = argv[argv.index("--append-system-prompt") + 1] if "--append-system-prompt" in argv else None
            sbtrace.event(self.session, "voice_start", model=self.asks, fresh=self.parent is None, turn_process=True,
                          parent=self.parent, system_prompt=sp,
                          tools=argv[argv.index("--tools") + 1] if "--tools" in argv else None)
        self.errfh = open(self.logpath, "ab", 0)
        try:
            self.start_at = os.path.getsize(self.logpath)
        except OSError:
            self.start_at = 0
        self.started_at, self.worked, self.born = time.time(), False, time.time()
        cwd = workspace_for(self.session)
        if self.parent is None and voice_from(self.session):
            cwd = conversation_dir(voice_from(self.session)) or cwd     # a fork resumes only from its folder
        elif self.parent is not None:
            cwd = conversation_dir(self.parent) or cwd
        self.proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=self.errfh, cwd=start_dir(cwd, argv))
        self.buf = b""

    def finish(self):
        """Its turn is over: it ends politely, so its transcript is whole for the fork that may follow it."""
        def end():
            try:
                self.stop()
            finally:
                self.done.set()
        threading.Thread(target=end, name="voice-turn-end", daemon=True).start()


_TOTALS = {}                      # conversation id -> its usage totals after its last turn (a fork carries them on)


class CallVoice(object):
    """A call's voice conversation, kept from its record: the head (the conversation with every committed
    turn), how much of the record it has (pos), and the turns asked on forks of it, until the record says
    which was committed (that fork becomes the head) and which weren't (deleted)."""

    def __init__(self):
        self.head, self.pos, self.answered = None, 0, set()
        self.forks = {}           # question id -> {"sid", "pos", "words", "engine"}
        self.ours = set()         # conversation ids made in this call (the forks): only these are deleted
        self.mtime = None         # the record's, when last looked at
        self.lock = threading.Lock()


_CALLS = {}
_SPARES = {}                      # call session -> its next turn's fork, started ahead
_SPARES_LOCK = threading.Lock()


def call_voice(session):
    with _SPARES_LOCK:
        return _CALLS.setdefault(session, CallVoice())


def promote(session):
    """The record's committed turns since the head: each one answered on a fork becomes the head, in order
    (its history has that turn, as asked and answered). Forks no turn kept are deleted. True if it moved."""
    cv = call_voice(session)
    with cv.lock:
        entries, moved = sbledger.read(session), False
        for k in range(cv.pos, len(entries)):
            e = entries[k]
            if e.get("kind") != "asked":
                continue
            w = sbledger.words(e.get("text"))
            hit = next((q for q, f in cv.forks.items() if f["words"] == w and f["pos"] <= k), None)
            if hit is None:
                continue
            f = cv.forks.pop(hit)
            old = cv.head
            cv.head, cv.pos, cv.answered, moved = f["sid"], f["pos"], {k}, True
            if f.get("engine") is not None:
                f["engine"].done.wait(10)           # its transcript is whole before anything forks it
            if old in cv.ours:
                _forget(old)
            for q in [q for q, g in cv.forks.items() if g["pos"] <= k]:
                g = cv.forks.pop(q)                 # asked before it and never kept: an early ask they went on from
                if g.get("engine") is not None:
                    g["engine"].done.wait(10)
                _forget(g["sid"])
        if moved:
            ensure_dirs()
            with open(uuid_path("%s.voice" % session), "w") as fh:
                fh.write(cv.head + "\n")             # the conversation the Mac carries to the agent's next call
        return moved


def _forget(sid):
    """A fork no turn kept: its transcript goes (sbagents.delete: only ever one Standby made)."""
    try:
        r = sbagents.delete(sid)
        if r.get("error"):
            sys.stderr.write("standby-agent: a call fork %s stays: %s\n" % (sid[:8], r["error"]))
    except Exception as exc:
        sys.stderr.write("standby-agent: deleting a call fork %s: %r\n" % (sid[:8], exc))


def delta(session, raw, entries):
    """What the head doesn't have yet, as blocks, then the question: the record's entries since its
    position, its own committed turn left out (it has it) except what they didn't hear of its reply."""
    cv = call_voice(session)
    out, mine = [], False
    for k in range(cv.pos, len(entries)):
        e = entries[k]
        if e.get("kind") == "asked" and k in cv.answered:
            mine = True
            continue
        if e.get("kind") == "you" and mine:
            mine = False
            if e.get("unsaid") or not (e.get("text") or "").strip():
                out.append("(They heard none of your last reply.)")
            elif e.get("cut"):
                out.append("YOU, as they heard it: " + " ".join(e["text"].split()) + sbledger.CUT)
            continue
        mine = False
        b = sbledger.block(e)
        if b:
            out.append(b)
    return out + [sbledger.asked_block(raw)]


def spare_fill(session, model):
    """The call's next turn's fork, from its head as it stands, started now if there's none (ahead of it)."""
    head = call_voice(session).head
    with _SPARES_LOCK:
        e = _SPARES.get(session)
        if e is not None and e.alive() and e.model == model and e.parent == head and e.dirs == voice_shape(session):
            return e
        _SPARES.pop(session, None)
    e = VoiceTurn(session, model, head)
    try:
        e.start()
    except Exception as exc:
        sys.stderr.write("standby-agent: could not start a call turn's Claude Code: %r\n" % exc)
        return None
    with _SPARES_LOCK:
        old = _SPARES.get(session)
        _SPARES[session] = e
    if old is not None and old is not e:
        old.stop(hard=True)
        _forget(old.sid)
    return e


def spare_take(session, model):
    """(the fork for this turn, how it came): the spare if it's ready and from the head as it stands, else one
    started now; a new spare starts behind it. Another model chosen meanwhile: switched (set_model)."""
    t0 = time.time()
    head = call_voice(session).head
    with _SPARES_LOCK:
        e = _SPARES.pop(session, None)
    how = {"spare": e is not None and e.alive() and e.parent == head and getattr(e, "dirs", None) == voice_shape(session)}
    if not how["spare"]:
        if e is not None:
            e.stop(hard=True)
            _forget(e.sid)
        e = VoiceTurn(session, model, head)
        e.start()
    elif e.model != model:
        why = e.switch(model)
        how["switched"] = why is None
        if why is not None:                       # refused: a new one asked for it from the start
            e.stop(hard=True)
            _forget(e.sid)
            e = VoiceTurn(session, model, head)
            e.start()
    how["age_ms"] = int((time.time() - e.born) * 1000)
    how["take_ms"] = int((time.time() - t0) * 1000)
    how["head"] = head
    call_voice(session).ours.add(e.sid)
    threading.Thread(target=spare_fill, args=(session, model), name="voice-spare", daemon=True).start()
    return e, how


def spare_retire(keep):
    with _SPARES_LOCK:
        gone = [(s, _SPARES.pop(s)) for s in list(_SPARES) if s not in keep]
        for s in [s for s in list(_CALLS) if s not in keep]:
            _CALLS.pop(s, None)
    for _s, e in gone:
        e.stop(hard=True)
        _forget(e.sid)


def watch_record(session, model):
    """Between turns: a committed turn in the record moves the head now, and the spare is forked from the
    new head, so the next turn never waits for one."""
    cv = call_voice(session)
    try:
        m = os.path.getmtime(sbledger.path(session))
    except OSError:
        return
    if m == cv.mtime:
        return
    cv.mtime = m
    if promote(session):
        spare_fill(session, model)


def _ledger_on():
    """Calls built from their record: config.json "voice": {"ledger": true}, read once as the agent starts;
    STANDBY_VOICE_LEDGER=1 or 0 overrides it. Off by default for now: the voice keeps its own conversation."""
    env = os.environ.get("STANDBY_VOICE_LEDGER")
    if env in ("0", "1"):
        return env == "1"
    try:
        with open(os.path.join(ROOT, "config.json")) as fh:
            return bool(((json.load(fh) or {}).get("voice") or {}).get("ledger", False))
    except (IOError, OSError, ValueError, AttributeError):
        return False


LEDGER_ON = None                  # _ledger_on(), the first time a call asks


def ledger_call(session):
    """A call from a Claude Code session, its voice turns built from the call's record (sbledger), when
    that's on (_ledger_on); else the conversation the voice keeps itself, as before."""
    global LEDGER_ON
    if LEDGER_ON is None:
        LEDGER_ON = _ledger_on()
    return LEDGER_ON and session != "none" and is_talk(session) and bool(voice_meta(session).get("handoff"))


def engine_for(session, model, kind="meeting"):
    engine = _LIVE_SESSION.get((session, kind))
    if engine is None:
        engine = _LIVE_SESSION[(session, kind)] = ClaudeSession(session, model, kind)
    return engine


def runs(session, kind, model):
    """The model a meeting's Claude Code really runs, as it said, else the one asked for."""
    engine = _LIVE_SESSION.get((session, kind))
    return (engine.runs or engine.asks) if engine is not None else model


class SigninWatch(object):
    """Claude Code's log (engine.log, shared by a meeting's engines: they sign in
    the same way) from where a turn began (or `at`): when each kind of sign-in
    failure first showed in it, and its lines (each once, the last few). Read at
    most four times a second."""

    KEEP = 6

    def __init__(self, path, at=None):
        self.path = path
        if at is None:
            try:
                at = os.path.getsize(path)
            except OSError:
                at = 0
        self.at = at
        self.seen, self.fatal, self.lines, self.checked = None, None, [], 0.0

    def failed(self, started):
        """The lines that end a turn begun at `started` that has heard nothing
        from Claude, or None: a failure that never recovers by itself, SIGNIN_GRACE
        ago; or one that may, and SIGNIN_SOFT_WAIT gone since the turn began."""
        self.poll()
        now = time.time()
        if self.fatal is not None and now - self.fatal >= SIGNIN_GRACE:
            return self.line
        if self.seen is not None and now - started >= SIGNIN_SOFT_WAIT:
            return self.line
        return None

    def ended(self):
        """Claude Code has exited: whatever sign-in failure it wrote is the reason, at
        once (no grace: there is nothing more to wait for), or None."""
        self.checked = 0.0
        self.poll()
        return self.line if self.seen is not None else None

    @property
    def line(self):
        return "\n".join(self.lines)

    def poll(self):
        now = time.time()
        if now - self.checked < 0.25:
            return self.seen
        self.checked = now
        try:
            with open(self.path, "rb") as fh:
                fh.seek(self.at)
                data = fh.read()
        except (IOError, OSError):
            return self.seen
        end = data.rfind(b"\n") + 1                  # whole lines only
        self.at += end
        for line in data[:end].decode("utf-8", "replace").splitlines():
            if any(m in line for m in SIGNIN_MARKS):
                self.seen = self.seen or now
                if any(m in line for m in SIGNIN_FATAL):
                    self.fatal = self.fatal or now
                line = line.strip()[:300]
                if line in self.lines:
                    self.lines.remove(line)
                self.lines = (self.lines + [line])[-self.KEEP:]
        return self.seen


def signin_kind(line):
    """How this Claude Code signs in, as far as its failure says: "google",
    "api_key" or "account". "Invalid API key · Please run /login" is said for a key
    and for an account's sign-in alike: a key set where it runs makes it the key."""
    if any(m in line for m in SIGNIN_GOOGLE):
        return "google"
    if "API key" in line and (os.environ.get("ANTHROPIC_API_KEY") or os.environ.get("ANTHROPIC_AUTH_TOKEN")):
        return "api_key"
    return "account"


def signin_fix(line):
    """What to do, by how Claude Code signs in."""
    return SIGNIN_FIXES[signin_kind(line)]


def signin_answer(line):
    """What a question hears when Claude Code cannot sign in: one spoken sentence
    with what to do, and below the --- line (shown, never read aloud) its own words."""
    return "%s %s, then ask again.\n\n---\nClaude Code's sign-in failed:\n%s" % (SIGNIN_SAID, signin_fix(line), line)


CLAUDE_ERROR = "claude-error.json"      # in live/: the last engine error, for the app


def claude_error_path():
    return os.path.join(LIVE, CLAUDE_ERROR)


def engine_error(rc, text):
    """A turn's failure as the app shows it ({kind, text, fix, detail}), or None
    for one that is not the user's to fix (a stuck turn, restarted)."""
    text = text or ""
    if rc == ClaudeSession.SIGNIN or any(m in text for m in SIGNIN_MARKS):
        line = text.split("---", 1)[-1].strip() if rc == ClaudeSession.SIGNIN else text
        return {"kind": "signin", "text": "Claude can't sign in.", "fix": signin_fix(line) + ", then try again.",
                "detail": line[:2000]}
    if "no claude binary" in text:
        return {"kind": "missing", "text": "Claude Code isn't installed where Standby runs it.",
                "fix": "Install it, then try again.", "detail": " ".join(text.split())[:600]}
    if text.startswith(("engine error", "Engine exited", "engine write failed")):
        return {"kind": "engine", "text": "Claude Code stopped with an error.",
                "fix": "Try again. If it keeps happening, start a new session: its checks say what is wrong.",
                "detail": " ".join(text.split())[:600]}
    return None


def note_engine(session, rc, text, label=None):
    """The one source of truth for "can Claude be reached": the agent's last
    engine error in live/claude-error.json (kind, text, fix, detail, at, the session
    and turn), gone with the next turn that works. Rewritten, never appended: the
    app shows one line however many turns fail."""
    path = claude_error_path()
    try:
        if rc == 0:
            if os.path.exists(path):
                os.remove(path)
            return
        # Stopped on purpose, or not sent at all (open in another Claude Code): neither says anything.
        err = engine_error(rc, text) if rc not in (ClaudeSession.INTERRUPTED, ClaudeSession.HELD) else None
        if err is None:
            return
        err.update(at=time.time(), session=session, turn=label)
        ensure_dirs()
        with open(path + ".tmp", "w") as fh:
            json.dump(err, fh, ensure_ascii=False)
        os.replace(path + ".tmp", path)
    except (IOError, OSError):
        pass


PROBE_TIMEOUT = float(os.environ.get("STANDBY_PROBE_TIMEOUT", 45))


def probe(timeout=PROBE_TIMEOUT):
    """One short Claude turn and nothing else (no tools, no MCP, not kept): can
    Claude be reached right now? (text, rc) as a turn's. Its log goes where the
    engines' does, so a sign-in failure ends it as fast (the Try again)."""
    if not os.path.exists(CLAUDE):
        return "engine error: no claude binary at %s" % CLAUDE, 1
    argv = [CLAUDE, "-p", "--model", model_for(IN_ITS_PLACE), "--tools", "", "--strict-mcp-config"]
    if claude_caps().get("no_persist"):
        argv.append("--no-session-persistence")
    argv += ["--output-format", "json", "Reply with exactly one character: ."]
    logpath = os.path.join(AGENT, "engine.log")
    ensure_dirs()
    watch = SigninWatch(logpath)
    with open(logpath, "ab", 0) as errfh:
        errfh.write(("\n=== %s probe ===\n" % time.strftime("%H:%M:%S")).encode("utf-8"))
        try:
            proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=errfh, cwd=AGENT)
        except OSError as exc:
            return "engine error: %r" % exc, 1
        started = time.time()
        end = started + timeout
        while proc.poll() is None:
            failed = watch.failed(started)
            if failed is not None:
                proc.kill()
                proc.wait()
                return signin_answer(failed), ClaudeSession.SIGNIN
            if time.time() > end:
                proc.kill()
                proc.wait()
                return "engine error: no answer from Claude Code in %ds" % timeout, 1
            time.sleep(0.1)
    out = proc.stdout.read().decode("utf-8", "replace").strip()
    try:
        result = json.loads(out.splitlines()[-1])
    except (ValueError, IndexError):
        failed = watch.ended()                  # it gave up at once: its log says why
        if failed is not None:
            return signin_answer(failed), ClaudeSession.SIGNIN
        return "engine error: %s" % (out[:300] or "Claude Code said nothing (exit %s)" % proc.returncode), 1
    if result.get("is_error"):
        said = str(result.get("result") or "unknown")
        if any(m in said for m in SIGNIN_MARKS):                # Claude Code's own sign-in failure
            return signin_answer(said), ClaudeSession.SIGNIN
        return "engine error: %s" % said, 1
    return str(result.get("result") or "."), 0


def cmd_probe(args):
    """Can Claude be reached right now, as JSON: {"ok": true} or {"ok": false,
    "error": {kind, text, fix, detail}}. Also what live/claude-error.json says
    from now on, as any turn does."""
    text, rc = probe()
    note_engine(getattr(args, "session", None) or current_session(), rc, text, "probe")
    print(json.dumps({"ok": rc == 0, "error": None if rc == 0 else engine_error(rc, text) or
                      {"kind": "engine", "text": "Claude Code stopped with an error.",
                       "fix": "Try again. If it keeps happening, start a new session: its checks say what is wrong.",
                       "detail": " ".join(text.split())[:600]}}))
    return 0


def engine_claude(question, session, model, timeout, should_interrupt=None,
                  on_event=None, max_total=None, kind="meeting", label=None):
    """One process per meeting and kind, kept warm for the whole meeting. Nothing is
    sent to a meeting's conversation while another Claude Code has it open."""
    if kind == "meeting" and guard(session) is not None:
        stale = _LIVE_SESSION.pop((session, kind), None)
        if stale is not None:
            stale.stop()                    # it reloads the conversation, theirs included, after
        return HELD_ANSWER, ClaudeSession.HELD
    engine = engine_for(session, model, kind)
    if kind == "voice" and engine.alive() and getattr(engine, "dirs", None) != voice_shape(session):
        # started before the call's voice.json said what the call is and where its session works (warmed up
        # ahead): again, as the call's; the conversation goes on from where it was
        sys.stderr.write("standby-agent: the voice for %s starts again as the call's (%s)\n" % (session, voice_shape(session)))
        engine.stop()
    if kind == "voice":
        wanted, was = live_voice_model(model), engine.asks
        if wanted != engine.model and wanted != engine.refused:      # refused: not asked again until it changes
            why = engine.switch(wanted)
            engine.refused = wanted if why is not None else None
            note_switch(session, wanted, was, why)
            if why is not None:
                sys.stderr.write("standby-agent: the voice for %s stays on %s, not %s: %s\n" % (session, was, wanted, why))
                sys.stderr.flush()
    try:
        text, rc = engine.ask(question, timeout, should_interrupt=should_interrupt,
                              on_event=on_event, max_total=max_total, label=label)
    except RuntimeError as exc:
        text, rc = "engine error: %s" % exc, 1
    except Exception as exc:
        engine.stop()
        text, rc = "engine error: %r" % exc, 1
    note_engine(session, rc, text, label)
    return text, rc


def prewarm(session, model, kind="meeting"):
    """Start a Claude Code before the first question needs it: a cold start
    paid 3-9 s on the first answer (measured). A call's voice: its first turn's own Claude Code (spare)."""
    if kind == "voice" and ledger_call(session):
        return spare_fill(session, live_voice_model(model)) is not None
    engine = engine_for(session, model, kind)
    if engine.alive():
        return False
    if kind == "voice":
        engine.switch(live_voice_model(model))   # not started: only which model it starts on
    try:
        engine.start()
    except Exception as exc:
        sys.stderr.write("standby-agent: could not warm up the %s engine: %r\n" % (kind, exc))
        return False
    sys.stderr.write("standby-agent: %s engine warming up for %s (%s)\n" % (
        kind, session, engine.asks if engine.asks == engine.model else "%s, %s is not available" % (engine.asks, engine.model)))
    sys.stderr.flush()
    return True


def engine_oneshot(question, session, model, timeout):
    """One process per question. Robust but pays ~9s of startup. Debug use."""
    if not os.path.exists(CLAUDE):
        return "engine error: no claude binary at %s" % CLAUDE, 1
    sid, fresh = session_uuid(session)
    owed = rules_owed(session, sid)
    if owed is not None:
        question = RULES_TURN % owed[0] + "\n\n" + question
    argv = build_argv(session, model, fresh, sid, stream=False) + [question]
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, cwd=AGENT)
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        return "timed out after %ds" % timeout, 1
    except Exception as exc:
        return "engine error: %r" % exc, 1
    text = (out or b"").decode("utf-8", "replace").strip()
    if proc.returncode != 0:
        detail = (err or b"").decode("utf-8", "replace").strip()
        if fresh:
            try:
                os.remove(os.path.join(AGENT, "%s.uuid" % session))
            except OSError:
                pass
        return "engine failed (rc=%d): %s" % (proc.returncode,
                                              detail[-800:] or text[-800:]), 1
    if owed is not None:
        with open(rules_path(session), "w") as fh:
            fh.write(owed[1] + "\n")
    return text or "(empty answer)", 0


def engine_mock(question, session, model, timeout):
    """Exercises every link of the plumbing without spawning a model."""
    ctx = ""
    tool = shutil.which("standby-ctx")
    if tool:
        try:
            ctx = subprocess.check_output(
                [tool, "recent", "--minutes", "2"],
                stderr=subprocess.STDOUT).decode("utf-8", "replace")
        except subprocess.CalledProcessError as exc:
            ctx = "standby-ctx failed: %s" % exc.output.decode("utf-8", "replace")
    last = [l for l in ctx.splitlines() if l and not l.startswith("#")]
    return ("MOCK[%s/%s] q=%r last=%r" % (model, session, question,
                                          last[-1] if last else None)), 0


ENGINES = {"claude": engine_claude, "oneshot": engine_oneshot,
           "mock": engine_mock}


# ------------------------------------------------------------------ commands

def fmt_row(row, alias=None, names=None, via=None):
    """One line. Via: where it came from, when that changed within the block."""
    t = int(row.get("t", 0) or 0)
    who = sbspeakers.label(row, alias or {}, names or {})
    if via:
        who = "%s (%s)" % (who, via) if who else "(%s)" % via
    return "%02d:%02d %s%s" % (t // 60, t % 60, (who + ": ") if who else "",
                               (row.get("text") or "").strip())


# where the lines came from: the session's table (live/<id>.sources.json, from the
# Mac, as the speaker names are), named once per block, per line only when it changes.
SOURCE_ROLE = {"Me": "You", "Room": "the room", "Others": "the call"}


def load_sources(session):
    try:
        with open(os.path.join(LIVE, session + ".sources.json")) as fh:
            rows = json.load(fh)
    except (IOError, ValueError):
        return {}
    return dict((r["id"], r) for r in rows if isinstance(r, dict) and r.get("id")) if isinstance(rows, list) else {}


class Feeder(object):
    """Tracks which transcript lines the agent has already been sent.

    The offset is persisted per session, so a server restart resumes the same
    conversation (--resume) without re-sending lines it already holds.
    """

    def __init__(self, session, tag=None):
        """tag: another reader with its own place in the transcript (the voice),
        which starts from the last VOICE_BRIEF_LINES: older talk is in the notes."""
        self.session = session
        # Per-session cadence, set on the Mac (dialog, --push-lines, or config);
        # the module defaults apply when a session does not say.
        meta = session_meta(session)
        self.push_lines = int(meta.get("push_lines") or PUSH_LINES)
        self.push_seconds = float(meta.get("push_seconds") or PUSH_SECONDS)
        if tag is None:
            sys.stderr.write("standby-agent: %s pushes every %d lines or %.0fs\n"
                             % (session, self.push_lines, self.push_seconds))
        self.path = os.path.join(LIVE, session + ".jsonl")
        self.state = os.path.join(AGENT, session + ("." + tag if tag else "") + ".fed")
        self.sent = 0
        self.last_push = time.time()
        try:
            with open(self.state) as fh:
                self.sent = int(fh.read().strip() or 0)
        except (IOError, ValueError):
            if tag:
                self.sent = max(0, len(self.rows()) - VOICE_BRIEF_LINES)

    def rows(self):
        out = []
        try:
            with open(self.path) as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
        except IOError:
            pass
        return out

    def unsent(self):
        return self.rows()[self.sent:]

    def mark(self, count):
        self.sent += count
        self.touch()
        ensure_dirs()
        with open(self.state, "w") as fh:
            fh.write("%d\n" % self.sent)

    def touch(self):
        """The meeting agent was just called (a push, a question, a hand-off, or a push that
        failed): the next push waits its PUSH_MIN_GAP from now, so Opus is never called
        twice back to back by the push."""
        self.last_push = time.time()

    def due(self, pending):
        if not pending:
            return False
        since = time.time() - self.last_push
        return since >= PUSH_MIN_GAP and (len(pending) >= self.push_lines
                                          or since >= self.push_seconds)


def session_clock(meta):
    """"Sun 4 Oct 06:22 CEST": when a session started, in the user's time zone
    (the Mac's, from the meta). A session that didn't say (from before the Mac
    wrote it) is told in the zone of the machine this runs on, named as such:
    on the Mac, the Mac's own. Never a fixed zone."""
    started = meta.get("started")
    if not isinstance(started, (int, float)):
        return None
    offset, tz = meta.get("utc_offset"), meta.get("tz")
    if not isinstance(offset, int):
        here = time.localtime(started)
        offset, tz = here.tm_gmtoff, time.strftime("%Z", here) or "local time"
    t = time.gmtime(started + offset)
    return "%s %d %s %s %s" % (time.strftime("%a", t), t.tm_mday, time.strftime("%b", t),
                               time.strftime("%H:%M", t), tz or "")


def transcript_block(rows, session=None):
    alias, names = sbspeakers.load(LIVE, session) if session else ({}, {})
    clock = session_clock(session_meta(session)) if session else None
    head = "(times are into the session; 00:00 was %s)\n" % clock.strip() if clock else ""
    table = load_sources(session) if session else {}
    first, lines = {}, []
    for r in rows:
        src, role, via = r.get("src"), r.get("speaker"), None
        if src in table:
            if role not in first:
                first[role] = src
            elif first[role] != src:                 # this channel's source changed in the block
                via = table[src].get("name")
        lines.append(fmt_row(r, alias, names, via))
    if first:
        head += "Sources: %s\n" % "; ".join("%s = %s" % (SOURCE_ROLE.get(role, role or "?"), table[sid].get("name"))
                                            for role, sid in first.items())
    return "[TRANSCRIPT]\n%s%s\n[END TRANSCRIPT]" % (head, "\n".join(lines))


# Answers logged before snapshots were removed may still carry these marks.
SNAP_MARK = "(snapshot attached)"
SNAP_MISSING_MARK = "(snapshot missing)"


def answer_once(question, args, logged_q=None, on_event=None, should_interrupt=None,
                model=None, kind="meeting", session=None, label="question"):
    session = session or args.session or current_session()
    started = time.time()
    if args.engine == "claude":
        text, rc = engine_claude(question, session, model or args.model, args.timeout,
                                 on_event=on_event, should_interrupt=should_interrupt, kind=kind,
                                 label=label)
    else:
        text, rc = ENGINES[args.engine](question, session, args.model, args.timeout)
    elapsed = time.time() - started
    ensure_dirs()
    with open(ANSWERS, "a") as fh:
        fh.write(json.dumps({"wall": time.strftime("%Y-%m-%dT%H:%M:%S"),
                             "session": session, "engine": args.engine,
                             "model": runs(session, kind, model or args.model) if args.engine == "claude"
                             else args.model, "seconds": round(elapsed, 1),
                             "q": logged_q or question, "a": parse_suggestions(text)[0]},
                            ensure_ascii=False) + "\n")
    return text, rc, elapsed


def cmd_ask(args):
    question = " ".join(args.question).strip()
    if not question:
        die("nothing to ask")
    text, rc, elapsed = answer_once(question, args)
    print(text)
    if args.timing:
        sys.stderr.write("[%.1fs %s]\n" % (elapsed, args.model))
    return rc


# ------------------------------------------------------------------ new code
#
# The server is long-lived, and its code can change under it (a merge, Install
# agent on remote). A server that kept running old code once mixed new prompts
# with old handling, so it checks its own files and, once nothing would notice,
# re-runs itself in place: same pid, conversations resumed from disk.

CODE_CHECK = float(os.environ.get("STANDBY_CODE_CHECK", 5))     # seconds between looks at its own files
VOICE_QUIET = float(os.environ.get("STANDBY_VOICE_QUIET", 120))  # voice idle this long: voice mode is over
RESTART_MARK = "standby-agent: RESTART"                          # easy to find in serve.log


def code_stamp():
    """When this program's files last changed on disk: itself and every sb*.py beside it
    (its helper modules), so a new one is watched without being listed anywhere."""
    here = os.path.dirname(os.path.realpath(__file__))
    out = []
    for path in [os.path.realpath(__file__)] + sorted(glob.glob(os.path.join(here, "sb*.py"))):
        try:
            out.append(os.stat(path).st_mtime)
        except OSError:
            out.append(None)
    return tuple(out)


def _stamp_text(stamp):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(max(t for t in stamp if t))) if any(stamp) else "?"


def restart_blocker(backend, voice):
    """Why not to re-run now (None if nothing would notice): work queued or under
    way, a voice conversation, or a conversation open in Claude Code."""
    try:
        names = os.listdir(SPOOL)
    except OSError:
        names = []
    if any(n.endswith((".q", ".vq", ".w")) for n in names):
        return "a question is waiting"
    if backend.lock.locked():
        return "the meeting agent is busy"
    if not voice.idle():
        return "voice mode is on"
    try:
        if any(n.endswith(".hold") for n in os.listdir(AGENT)):
            return "a conversation is open in Claude Code"
    except OSError:
        pass
    return None


def restart_in_place(stamp):
    """Re-run this server with its new code, in this process (the pidfile stays
    right). Warm Claude Codes are stopped; their conversations resume from disk."""
    sys.stderr.write("%s: my code changed on disk (now %s); restarting into it\n" % (RESTART_MARK, _stamp_text(stamp)))
    sys.stderr.flush()
    for engine in list(_LIVE_SESSION.values()):
        engine.stop()
    spare_retire(())
    os.environ["STANDBY_RESTARTED"] = "1"
    os.execv(sys.executable, [sys.executable, os.path.realpath(__file__)] + sys.argv[1:])


def server_pid():
    """The live server's pid, or None. Cleans a stale pidfile as a side effect:
    only one naming a process gone. One it cannot read is left alone (it was
    read empty mid-write once, removed, and a second server started)."""
    if not os.path.exists(PIDFILE):
        return None
    try:
        with open(PIDFILE) as fh:
            pid = int(fh.read().strip())
    except (ValueError, IOError, OSError):
        return None
    try:
        os.kill(pid, 0)
        return pid
    except OSError:
        try:
            os.remove(PIDFILE)
        except OSError:
            pass
        return None


_SERVER_LOCK = []


def hold_server_lock(wait=2.0):
    """One server per root: an exclusive lock, held until this process ends,
    however it ends (the kernel lets go). The pidfile alone let two start at
    once, and `stop` knew only one. Tried for a moment: a re-exec into new
    code lets go and takes it again."""
    import fcntl
    fh = open(LOCKFILE, "a")
    end = time.time() + wait
    while True:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            _SERVER_LOCK.append(fh)
            return True
        except (IOError, OSError):
            if time.time() >= end:
                fh.close()
                return False
            time.sleep(0.05)


def cmd_alive(_args):
    """Exit 0 if a server is running. Scriptable liveness for the Mac client."""
    pid = server_pid()
    if pid is None:
        return 1
    print(pid)
    return 0


def cmd_stop(_args):
    pid = server_pid()
    if pid is None:
        print("not running")
        return 0
    import signal as _signal
    os.kill(pid, _signal.SIGTERM)
    for _ in range(40):
        time.sleep(0.1)
        if server_pid() is None:
            print("stopped %d" % pid)
            return 0
    print("did not stop, killing %d" % pid)
    os.kill(pid, _signal.SIGKILL)
    return 0


class DeepMarker(object):
    """Streamed answer text, minus the [DEEP] handoff line and a call's [QUIET]: they are
    signals, never something to show or say. A tail that may still become one of them
    is held back until it is clear."""

    TAGS = (DEEP_TAG, QUIET_TAG, END_TAG, "[CANCEL")

    def __init__(self):
        self.held, self.deep = "", False

    def feed(self, text):
        if self.deep:
            return ""                        # after [DEEP]: the task for the stronger agent, never said
        buf = self.held + text
        if DEEP_TAG in buf:
            buf, self.deep = buf[:buf.index(DEEP_TAG)], True
        for tag in self.TAGS[:3]:
            buf = buf.replace(tag, "")
        self.held = ""
        while "[CANCEL" in buf:              # "[CANCEL #3]": the voice stops a task; never said
            i = buf.index("[CANCEL")
            j = buf.find("]", i)
            if j < 0:
                self.held, buf = buf[i:], buf[:i]
                return buf
            buf = buf[:i] + buf[j + 1:]
        for k in range(max(len(t) for t in self.TAGS) - 1, 0, -1):
            if any(len(t) > k and buf.endswith(t[:k]) for t in self.TAGS):
                self.held, buf = buf[-k:], buf[:-k]
                break
        return buf

    def flush(self):
        out, self.held = ("" if self.deep else self.held), ""
        return out


# ------------------------------------------------------------------ suggestions
#
# Replies Claude gives anyway (a listen turn's notes, an answer) may end with up to
# SUGGEST_MAX lines "SUGGEST: <question>": what the user could ask next, shown as
# buttons. They are cut out of everything else (the notes, the answer, what the
# voice says, even mid-stream) and kept in live/<session>.suggest.json for the
# app. No call of their own.

SUGGEST_MAX, SUGGEST_WORDS = 3, 8
SUGGEST_KEEP = 300.0      # a reply without suggestions clears the old ones only once they are this old
_SUGGEST_LINE = re.compile(r"^[ \t]*(?:[-*\u2022]+[ \t]*)?\**SUGGEST:\**[ \t]*(.*?)[ \t]*$", re.I | re.M)


def parse_suggestions(text):
    """(the text without its SUGGEST lines, [the suggestions, as written])."""
    text = text or ""
    items = [m.group(1).strip().strip('"\u201c\u201d').strip() for m in _SUGGEST_LINE.finditer(text)]
    if not items:
        return text, []
    return _SUGGEST_LINE.sub("", text).rstrip(), [i for i in items if i]


class SuggestFilter(object):
    """Streamed text minus SUGGEST lines, so the voice never speaks one: the start of
    each line is held back until it cannot be one."""

    TAG = "SUGGEST:"

    def __init__(self):
        self.held, self.state = "", "start"      # start of a line | free | dropping

    def feed(self, text):
        out = []
        for ch in text:
            if ch == "\n":
                if self.state != "dropping":
                    out.append(self.held + ch)
                self.held, self.state = "", "start"
            elif self.state == "free":
                out.append(ch)
            elif self.state == "start":
                self.held += ch
                head = re.sub(r"^[ \t]*(?:[-*\u2022]+[ \t]*)?\**", "", self.held).upper()
                if head.startswith(self.TAG):
                    self.held, self.state = "", "dropping"
                elif not self.TAG.startswith(head):
                    out.append(self.held)
                    self.held, self.state = "", "free"
        return "".join(out)


def _norm_question(q):
    return " ".join(re.sub(r"[^a-z0-9 ]+", " ", (q or "").lower()).split())


def asked_questions(session):
    """What the user has asked in this session, from the answers log."""
    out = set()
    try:
        with open(ANSWERS) as fh:
            rows = [json.loads(l) for l in fh if l.strip()]
    except (IOError, ValueError):
        rows = []
    for row in rows:
        if row.get("session") == session:
            q = re.sub(r"^\(voice\) ", "", row.get("q") or "")
            q = q.replace(SNAP_MARK, "").replace(SNAP_MISSING_MARK, "")
            out.add(_norm_question(q))
    return out


def suggest_path(session):
    return os.path.join(LIVE, session + ".suggest.json")


def record_suggestions(session, items, source):
    """Keep the newest useful set for the app: at most SUGGEST_MAX, of at most
    SUGGEST_WORDS words (longer ones are dropped, not cut), no repeats, none the
    user already asked. A reply with none keeps the old set until it is
    SUGGEST_KEEP old. Returns what the file now holds."""
    try:
        return _record_suggestions(session, items, source)
    except Exception as exc:             # never at the cost of a note or an answer
        sys.stderr.write("standby-agent: suggestions not kept: %r\n" % exc)
        return {}


def _record_suggestions(session, items, source):
    if session == "none":
        return {}
    asked, seen, keep = asked_questions(session) if items else set(), set(), []
    for item in items:
        n = _norm_question(item)
        if not n or n in seen or n in asked or len(item.split()) > SUGGEST_WORDS:
            continue
        seen.add(n)
        keep.append(item)
        if len(keep) == SUGGEST_MAX:
            break
    path = suggest_path(session)
    try:
        with open(path) as fh:
            old = json.load(fh)
    except (IOError, ValueError):
        old = {}
    if not keep and (not old.get("items") or time.time() - old.get("at", 0) < SUGGEST_KEEP):
        return old
    data = {"at": time.time(), "from": source, "items": keep}
    with open(path + ".tmp", "w") as fh:
        json.dump(data, fh, ensure_ascii=False)
    os.rename(path + ".tmp", path)
    return data


def wants_deep(text):
    return DEEP_TAG in (text or "")


# A [DEEP] with no task after it: the voice is asked for one, once, in its own conversation (it
# has the context); its answer is what the session works on.
TASK_TURN = ("[TASK] You went deeper without saying on what. Write it now: only what to do, in your "
             "words, with what it needs to know.")
_NOTES = re.compile(r'^\s*\(They (?:went on before hearing your answer\.|cut in while you were saying: ".*?")\)\s*', re.S)
_BLOCKS = re.compile(r"\[SUMMARY\].*?\[END SUMMARY\]\s*|\[RESULT[^\]]*\].*?\[END RESULT\]\s*|^\[(?:SESSION|RESUMED)\][^\n]*\n?",
                     re.S | re.M)


def _cut_off(cpath):
    """A voice question stopped because the user cut the voice off (agentctl.cancel keep), not because
    they went on."""
    try:
        with open(cpath) as fh:
            return fh.read().strip() == "keep"
    except OSError:
        return False


def clean_words(words):
    """The user's words without any note of ours: what they heard of an answer they cut
    off, the session's progress or summary, a snapshot's mark."""
    text = _BLOCKS.sub("", words or "")
    text = _NOTES.sub("", text)
    return " ".join(text.split())


def deep_task(text):
    """What follows [DEEP]: the voice's own words for the work it hands on, or "" for none."""
    return (text or "").split(DEEP_TAG, 1)[1].strip() if DEEP_TAG in (text or "") else ""


def strip_deep(text):
    return (text or "").replace(DEEP_TAG, "").strip()


def _answer(apath, text):
    with open(apath + ".tmp", "w") as fh:
        fh.write(text)
    os.rename(apath + ".tmp", apath)


def _progress_writer(ppath, t0, timing, marker, asked=None):
    """Progress events for one question, to the file its client streams from.
    The [DEEP] signal and SUGGEST lines never show (nor are spoken); the first
    word's time is noted.

    asked: a voice question's queued time (its id). Then, just before its first word,
    one {"kind": "timing"} event with when it was queued, taken by the voice thread
    (t0), handed to Claude Code ("sent") and its first word, all on this machine's
    clock: the Mac subtracts them among themselves, so the two clocks never need
    to agree."""
    lines = {"for": None, "filter": None}

    def progress(kind, text):
        if kind == "sent":                            # the turn went to Claude Code: noted, not shown
            if timing.get("first") is None:
                timing["sent"] = time.time()
            return
        if kind == "delta":
            if lines["for"] is not marker[0]:          # a new reply (the [DEEP] hand-off): a fresh filter
                lines.update({"for": marker[0], "filter": SuggestFilter()})
            text = lines["filter"].feed(marker[0].feed(text))
            if not text:
                return
            if timing.get("first") is None:
                timing["first"] = time.time() - t0
                if asked is not None:
                    with open(ppath, "a") as fh:
                        fh.write(json.dumps({"kind": "timing", "queued": round(asked, 3), "taken": round(t0, 3),
                                             "sent": round(timing.get("sent") or t0, 3),
                                             "word": round(t0 + timing["first"], 3)}) + "\n")
        elif kind == "text":
            text = parse_suggestions(strip_deep(text))[0]
        with open(ppath, "a") as fh:
            fh.write(json.dumps({"kind": kind,
                                 "text": text if kind in ("delta", "text") else text[:400],
                                 "t": round(time.time() - t0, 1)}, ensure_ascii=False) + "\n")
        if kind == "tool":
            sys.stderr.write("  . %s\n" % text)
            sys.stderr.flush()
    return progress


def _suggest_event(ppath, t0, data):
    """The suggestions an answer left, for the Mac: written before the answer, so
    its client streams them first."""
    if data.get("items") is None:
        return
    with open(ppath, "a") as fh:
        fh.write(json.dumps({"kind": "suggest", "items": data.get("items") or [], "from": data.get("from"),
                             "t": round(time.time() - t0, 1)}, ensure_ascii=False) + "\n")


def answer_suggestions(session, text, ppath, t0):
    """An answer's text without its SUGGEST lines; the lines are kept for the app."""
    text, items = parse_suggestions(text)
    if items:
        _suggest_event(ppath, t0, record_suggestions(session, items, "answer"))
    return text


SUGGEST_RULE = ("(You may end with up to 3 lines \"SUGGEST: <question>\": what the user could ask you next, "
                "at most 8 words each, specific, never one already asked. They show as buttons.)")


def suggest_rule(session):
    """The rule, for a meeting whose instructions are the user's own edit and lack it."""
    return "" if is_talk(session) or "SUGGEST:" in prompt_template()[0] else "\n" + SUGGEST_RULE


def spoken_part(text):
    """What a [VOICE] answer says out loud: the part before a --- line."""
    return re.split(r"(?m)^[ \t]*-{3,}[ \t]*$", text or "", 1)[0].strip()


class Backend(object):
    """The meeting agent: one Claude Code per meeting on the deep model. The
    serve loop listens and answers typed questions with it; the voice borrows
    it for real work. One turn at a time, so it is behind a lock, and a
    borrower waiting stops a listen turn at once (that one only digests)."""

    def __init__(self, args, model):
        self.args, self.model = args, model
        self.lock = threading.Lock()
        self.wanted = threading.Event()
        self.feeders = {}

    def feeder(self, session):
        if session not in self.feeders:
            self.feeders[session] = Feeder(session)
            # A new meeting started: retire engines for older sessions. Not
            # the live one's, when an ended talk is asked something meanwhile.
            for key in list(_LIVE_SESSION):
                if key[0] not in (session, current_session()):
                    _LIVE_SESSION.pop(key).stop()
                    sys.stderr.write("standby-agent: retired %s engine for %s\n" % (key[1], key[0]))
            spare_retire((session, current_session()))
        return self.feeders[session]

    def ask(self, header, question, session, progress, stopping, logged_q, label="question"):
        """A question with any transcript it has not seen yet. Call with the lock held."""
        if header == "[QUESTION]":
            header += suggest_rule(session)
        prompt, fed = question, 0
        if session != "none" and self.args.engine == "claude":
            feeder = self.feeder(session)
            rows = feeder.unsent() if listens(session) else []
            fed = len(rows)
            prompt = "%s\n%s%s" % (header, (transcript_block(rows, session) + "\n") if rows else "",
                                   question)
        text, rc, elapsed = answer_once(prompt, self.args, logged_q=logged_q, on_event=progress,
                                        should_interrupt=stopping, model=self.model, session=session,
                                        label=label)
        # A stopped turn still delivered its message, transcript included. Any turn that went
        # to Claude Code counts as the push, with lines or without: the next one waits its gap.
        if fed and rc in (0, ClaudeSession.INTERRUPTED):
            self.feeder(session).mark(fed)
        elif session != "none" and self.args.engine == "claude" and rc != ClaudeSession.HELD:
            self.feeder(session).touch()
        return text, rc, elapsed, fed


NOTE_TAGS = (("[RESULT", "result"), ("[SESSION]", "session"), ("[RESUMED]", "resumed"), ("[CHAT]", "chat"),
             ("[SUMMARY", "summary"), ("[CALL START]", "call start"), ("[TYPED", "typed"))


def note_kinds(words):
    """The notes folded into a voice question: [{kind, chars}], for the trace."""
    out = []
    for line in (words or "").split("\n"):
        for tag, kind in NOTE_TAGS:
            if tag in line:
                out.append({"kind": kind, "chars": len(line)})
                break
    return out


def task_what(task):
    """A voice-thread task in a few words, for what a question waited on (the trace)."""
    if task[0] == "spawn":
        return "starting Claude Code"
    if task[0] == "brief":
        return "the briefing"
    words = (task[2] if len(task) > 2 else "") or ""
    words = words[len(VOICE_TAG):].strip() if words.startswith(VOICE_TAG) else words
    if words.startswith(CALL_START):
        return "the greeting"
    if words.startswith(RESUMED_TAG):
        return "back from a pause"
    if RESULT_RE.match(words):
        return "telling what came back"
    return "another turn"


class Voice(object):
    """Voice mode's side of the agent, on its own thread so a spoken question
    never waits behind the meeting agent's listening. Each turn carries what is
    new for the voice: transcript lines, the meeting agent's notes, the chat."""

    def __init__(self, args, backend, model):
        self.args, self.backend, self.model = args, backend, model
        self.tasks = []
        self.cv = threading.Condition()
        self.feeders, self.notes_at, self.context = {}, {}, {}
        self.busy, self.last_used = False, 0.0
        self.briefed = None          # (start, end) of the last briefing, for its wait
        self.did = []                # the last tasks: (what, start, end), for what a question waited on
        threading.Thread(target=self._run, name="voice", daemon=True).start()

    # -- shared with the serve loop -------------------------------------------
    def submit(self, task):
        with self.cv:
            self.tasks.append(task)
            self.cv.notify()

    def remember(self, session, text):
        """Something the voice should know at its next turn (chat, answers)."""
        with self.cv:
            self.context.setdefault(session, []).append(text[:VOICE_CONTEXT_CHARS])

    # -- the worker -------------------------------------------------------------
    def _next(self):
        """A task from the serve loop, else a voice question or a warm-up from
        the spool: watched here, not by the serve loop, which may be busy for a
        while in a listen turn."""
        with self.cv:
            if not self.tasks:
                self.cv.wait(POLL)
            if self.tasks:
                return self.tasks.pop(0)
        try:
            names = sorted(n for n in os.listdir(SPOOL) if n.endswith(".vq") or n.endswith(".w"))
        except OSError:
            return None
        for name in names:
            path = os.path.join(SPOOL, name)
            try:
                with open(path) as fh:
                    text = fh.read().strip()
                os.remove(path)
            except (IOError, OSError):
                continue
            if name.endswith(".w"):
                return ("brief", current_session())
            if text.startswith(VOICE_TAG):
                text = text[len(VOICE_TAG):].strip()
            return ("ask", name[:-3], text)
        return None

    def idle(self):
        """Nothing queued, nothing under way, and no voice use for VOICE_QUIET:
        voice mode is over, as far as the agent can tell."""
        with self.cv:
            return not self.tasks and not self.busy and time.time() - self.last_used > VOICE_QUIET

    def _run(self):
        user_interactive()                   # a call's voice, ahead of a busy Mac's other work
        while True:
            task = self._next()
            if task is None:
                cur = current_session()
                if cur in _CALLS and ledger_call(cur):   # a turn committed: the head moves, the spare follows it
                    watch_record(cur, live_voice_model(self.model))
                if _SPARES and self.idle():           # voice mode is over: no Claude Code kept waiting for it
                    spare_retire(())
                continue
            with self.cv:
                self.busy = True
            began = time.time()
            try:
                if task[0] == "spawn":
                    prewarm(task[1], self.model, "voice")
                elif task[0] == "brief":
                    self._brief(task[1])
                else:
                    self._turn(*task[1:])
            except Exception as exc:
                import traceback
                sys.stderr.write("voice: %r\n%s" % (exc, traceback.format_exc()))
                sys.stderr.flush()
                if task[0] == "ask":
                    _answer(os.path.join(SPOOL, task[1] + ".a"),
                            "Sorry, something went wrong on my side. Ask me again?")
            finally:
                self.did = (self.did + [(task_what(task), began, time.time())])[-12:]
                left = _LIVE_SESSION.get((current_session(), "voice"))
                if isinstance(left, VoiceTurn):         # a call turn that raised: its Claude Code goes with it
                    _LIVE_SESSION.pop((current_session(), "voice"), None)
                    left.stop(hard=True)
                with self.cv:
                    self.busy = False
                    if task[0] != "spawn":            # warm-ups and turns mean voice mode is in use
                        self.last_used = time.time()

    def _feeder(self, session):
        if session not in self.feeders:
            self.feeders[session] = Feeder(session, tag="voice")
        return self.feeders[session]

    def _notes(self, session):
        path = os.path.join(LIVE, session + ".notes.md")
        try:
            with open(path) as fh:
                fh.seek(self.notes_at.get(session, 0))
                text = fh.read()
                return text.strip(), fh.tell()
        except IOError:
            return "", self.notes_at.get(session, 0)

    def _message(self, session, head, tail):
        feeder = self._feeder(session)
        rows = feeder.unsent() if listens(session) else []
        notes, notes_end = self._notes(session)
        with self.cv:
            context = self.context.pop(session, [])
        parts = [head]
        if rows:
            parts.append(transcript_block(rows, session))
        if notes:
            parts.append("[NOTES from the meeting agent]\n%s\n[END NOTES]" % notes)
        if context:
            parts.append("[CHAT]\n%s\n[END CHAT]" % "\n".join(context))
        parts.append(tail)

        def commit():
            feeder.mark(len(rows))
            self.notes_at[session] = notes_end

        def restore():
            with self.cv:
                self.context[session] = context + self.context.get(session, [])
        return "\n".join(parts), commit, restore

    @staticmethod
    def _asked():
        """A voice question in the spool, not yet taken."""
        try:
            return any(n.endswith(".vq") for n in os.listdir(SPOOL))
        except OSError:
            return False

    def _brief(self, session):
        """Voice mode opened: the voice catches up now, before the first words.
        A talk has nothing to catch up on. A question never waits for it (it
        took up to 5.6 s): with one already waiting there is no brief, the
        question's own message carries all that is new; one that arrives stops
        it. What a stopped brief sent is in the voice's conversation by then, as
        with a stopped listen turn, so it is not sent again."""
        if session != "none" and is_talk(session):
            # a call: its voice's process is started now (the app's warm-up comes once its voice.json is
            # written), while the call connects, so the greeting never waits for it (nothing to catch up on)
            prewarm(session, self.model, "voice")
            return
        if session == "none" or is_talk(session):
            return
        if self._asked():
            sys.stderr.write("voice: no briefing for %s: a question is waiting, and brings it\n" % session)
            sys.stderr.flush()
            return
        msg, commit, restore = self._message(
            session, "[BRIEFING] The user just opened voice mode. The meeting so far:",
            "Reply with exactly one character: .")
        t0 = time.time()
        text, rc = engine_claude(msg, session, self.model, LISTEN_TIMEOUT, kind="voice",
                                 should_interrupt=self._asked, label="briefing")
        (commit if rc in (0, ClaudeSession.INTERRUPTED) else restore)()
        self.briefed = (t0, time.time())
        sys.stderr.write("voice: briefed for %s in %.1fs%s\n" % (
            session, time.time() - t0, {0: "", ClaudeSession.INTERRUPTED: "  STOPPED for a question"}.get(
                rc, "  FAILED: %s" % text[:200])))
        sys.stderr.flush()

    def _ledger_message(self, session, raw):
        """A call's turn as the voice reads it: the call's record (sbledger) as blocks, oldest first, its
        question last. What came with the question goes in the record first, as facts of its own: the
        opening (session, summary, their last message before the call), the notes the Mac folded into their
        words, what the voice was told since (remember), and the tasks when they changed."""
        entries, new = sbledger.read(session), []
        if raw.startswith(CALL_START):
            extra = sbledger.opening(raw)
            new.append(("fact", "[CALL] %s%s" % (call_opening(session), "\n" + extra if extra else "")))
        elif not raw.startswith(RESUMED_TAG) and not sbledger.told(raw):
            for note in sbledger.folded(raw):
                m = RESULT_IN_TURN.match(note + "\n")
                new.append(("fact", "RESULT (%s, while they were talking): %s" % (m.group(1) or "done", m.group(2).strip())
                            if m else note))
        with self.cv:
            context = self.context.pop(session, [])
        new += [("fact", c) for c in context]
        try:
            with open(os.path.join(ROOT, "sessions", session, "tasks.txt"), encoding="utf-8") as fh:
                tasks = fh.read().strip()
        except (IOError, OSError):
            tasks = None
        was = sbledger.last(entries, "tasks")
        if tasks is not None and tasks != ((was or {}).get("text") or "").strip() and (tasks or was):
            new.append(("tasks", tasks))
        for kind, text in new:
            if kind == "fact" and sbledger.has_fact(entries, text):
                continue                          # told once: a dropped early ask's notes are already here
            sbledger.append(session, kind, text)
            entries.append({"kind": kind, "text": text})
        self.pos_after = len(entries)            # what of the record this turn's fork has, once asked
        return delta(session, raw, entries)

    def _ask_turn(self, turn, session, msg, interrupt, progress):
        """One ask of a call turn's own Claude Code, as engine_claude asks the kept one."""
        try:
            text, rc = turn.ask(msg, self.args.timeout, should_interrupt=interrupt, on_event=progress, label="voice")
        except RuntimeError as exc:
            text, rc = "engine error: %s" % exc, 1
        except Exception as exc:
            turn.stop()
            text, rc = "engine error: %r" % exc, 1
        note_engine(session, rc, text, "voice")
        return text, rc

    def _turn(self, ident, words):
        apath, cpath = (os.path.join(SPOOL, ident + ext) for ext in (".a", ".c"))
        if os.path.exists(cpath):
            os.remove(cpath)
            return _answer(apath, STOPPED)
        session = current_session()
        t0, timing, marker = time.time(), {}, [DeepMarker()]
        stopping = lambda: os.path.exists(cpath)
        raw, ledger = words, ledger_call(session)     # the question as asked; a call: built from its record
        try:
            asked_at = int(ident.split("-")[0]) / 1000.0         # its id is when it was asked, in ms
        except ValueError:
            asked_at = t0
        progress = _progress_writer(os.path.join(SPOOL, ident + ".p"), t0, timing, marker, asked=asked_at)
        if sbtrace.enabled(session):                 # a debugging trace, off unless asked for
            held = [(w, s, e) for w, s, e in self.did if e > asked_at]
            sbtrace.event(session, "wait", q=ident, ms=int(max(0.0, t0 - asked_at) * 1000),
                          on=[{"what": w, "ms": int((e - max(s, asked_at)) * 1000)} for w, s, e in held],
                          words=words, notes=note_kinds(words))
        if self.briefed and self.briefed[1] > asked_at:
            sys.stderr.write("voice: question waited %.1fs for the briefing\n"
                             % (self.briefed[1] - max(asked_at, self.briefed[0])))
        sys.stderr.write("> voice: %s\n" % words)
        sys.stderr.flush()
        if words.startswith(CALL_START) and voice_meta(session).get("handoff"):
            # the call's own: its session, and what the session has been working on (out of the system
            # prompt, so that stays the same call after call, and cached)
            words = "%s\n%s%s" % (CALL_START, call_opening(session), words[len(CALL_START):])
        folded = RESULT_IN_TURN.search(words)
        resumed = words.startswith(RESUMED_TAG)
        result = None if folded else RESULT_RE.match(words)
        if resumed:                          # back from a pause: what waited, as information; no words of theirs
            rest = (words[:folded.start()] + words[folded.end():]).strip() if folded else words
            said = rest + ("\n\n" + RESULT_TURN % (RESULT_HOW.get(folded.group(1), RESULT_HOW["done"]),
                                                    folded.group(2).strip()[:6000] or "(nothing)") if folded else "")
            result = True
        elif folded:                         # what they said, then what came back meanwhile, as background
            words = (words[:folded.start()] + words[folded.end():]).strip()
            said = "They said: %s\n\n%s" % (words, RESULT_LATER % (RESULT_HOW.get(folded.group(1), RESULT_HOW["done"]),
                                                                    folded.group(2).strip()[:6000] or "(nothing)"))
        else:
            said = (RESULT_TURN % (RESULT_HOW.get(result.group(1), RESULT_HOW["done"]),
                                   result.group(2).strip()[:6000] or "(nothing)") if result else "They said: " + words)
        turn = None                          # a call's turn: its own Claude Code (VoiceTurn), stopped after it
        if ledger:
            promote(session)                     # the turns the record says were committed: in the head first
            msg, commit, restore = self._ledger_message(session, raw), (lambda: None), (lambda: None)
        else:
            msg, commit, restore = self._message(session, "[VOICE]", said)
        # Cut off once its words are out and its hand-off has begun ([DEEP] streamed): the task streams on
        # to its end, so the work it said it's starting still goes (the hand-off below)
        call = bool(voice_meta(session).get("handoff"))
        interrupt = lambda: stopping() and not (call and marker[0].deep and _cut_off(cpath))
        if ledger:
            turn, how = spare_take(session, live_voice_model(self.model))
            _LIVE_SESSION[(session, "voice")] = turn         # what runs() and the trace read
            sbtrace.event(session, "voice_turn", q=ident, blocks=len(msg), **how)
        sent_at = time.time()
        if turn is not None:
            text, rc = self._ask_turn(turn, session, msg, interrupt, progress)
        else:
            text, rc = engine_claude(msg, session, self.model, self.args.timeout, kind="voice",
                                     should_interrupt=interrupt, on_event=progress, label="voice")
        replied, replied_at = text, time.time()
        (commit if rc in (0, ClaudeSession.INTERRUPTED) else restore)()
        went = runs(session, "voice", self.model)
        # Cut off as it spoke (not "they went on", whose next turn has it all): a hand-off its reply made in
        # full, task and all, still goes; it may have said it's on it
        handed = (rc == 0 and not result and wants_deep(text) and bool(voice_meta(session).get("handoff"))
                  and (not stopping() or (_cut_off(cpath) and bool(deep_task(text)))))
        if result:
            # news to tell, in its words: nothing to hand on. A [DEEP] here is never handed on, and what
            # follows it is its task, never words: only what it said before the tag is said
            text = text.split(DEEP_TAG, 1)[0].strip() if DEEP_TAG in (text or "") else text
            went += ", telling the user how the handed-on work went"
        elif handed:
            task = deep_task(text)           # the voice's own instruction to Claude Code
            if not task:                     # a bare [DEEP]: asked for once, in its conversation
                if turn is not None:             # in the same turn's Claude Code: it knows what it meant
                    asked, rc2 = self._ask_turn(turn, session, TASK_TURN, None, None)
                else:
                    asked, rc2 = engine_claude(TASK_TURN, session, self.model, self.args.timeout, kind="voice",
                                               label="voice")
                task = " ".join(strip_deep(parse_suggestions(asked)[0]).split()) if rc2 == 0 else ""
                task = "" if task in (QUIET_TAG, STOPPED) else task
                sys.stderr.write("voice: the hand-off had no task; asked for one: %s\n" % (task[:120] or "none"))
            task = task or clean_words(words)  # never a note of ours
            # a task it stopped to make room for this one ([CANCEL #n] before [DEEP]) goes to the Mac too
            text = "%s %s%s" % (HANDOFF_TAG, task, "".join(" [CANCEL #%s]" % n for n in CANCEL_RE.findall(text or "")))
            went += ", handed to the Claude Code session"
            self.remember(session, "You took this deeper, and are working on it now: %s" % task)
        elif rc == 0 and wants_deep(text) and holder(session) is not None:
            text = HELD_VOICE                # the meeting agent's conversation is in a terminal
        elif rc == 0 and wants_deep(text) and not stopping():
            # Real work: the meeting agent answers, out loud, with everything it knows.
            progress("tool", "Asking the meeting agent" if listens(session) else "Thinking it through")
            marker[0] = DeepMarker()
            self.backend.wanted.set()
            with self.backend.lock:
                self.backend.wanted.clear()
                text, rc, _el, _fed = self.backend.ask(VOICE_RULES, words, session, progress,
                                                       stopping, "(voice) " + words, label="deep")
            went = "%s, then the meeting agent (%s)" % (went, runs(session, "meeting", self.backend.model))
            if rc == 0:
                self.remember(session, "You handed this to %s: %s\nIt answered (the user heard it): %s"
                                       % ("the meeting agent" if listens(session) else "the stronger agent",
                                          words,
                                          spoken_part(parse_suggestions(text)[0])))
        else:
            text = strip_deep(text)
        if rc == 0 and text != HELD_VOICE and not handed and not result:
            text = answer_suggestions(session, text, os.path.join(SPOOL, ident + ".p"), t0)
        if os.path.exists(cpath):
            os.remove(cpath)
            if rc == ClaudeSession.INTERRUPTED:
                text = STOPPED
        first = timing.get("first")
        engine = _LIVE_SESSION.get((session, "voice"))
        if sbtrace.enabled(session):
            sbtrace.event(session, "model", q=ident, model=runs(session, "voice", self.model), sent_chars=len("\n\n".join(msg) if isinstance(msg, list) else msg),
                          sent="\n\n".join(msg) if isinstance(msg, list) else msg,
                          prep_ms=int((sent_at - t0) * 1000), first_token_ms=int(first * 1000 - (sent_at - t0) * 1000)
                          if first is not None else None, model_ms=int((replied_at - sent_at) * 1000),
                          total_ms=int((time.time() - t0) * 1000), reply=replied, said=text, went=went,
                          tokens=getattr(engine, "last_share", None),
                          outcome="stopped" if text == STOPPED else "handed" if handed else "quiet" if (text or "").strip()
                          == QUIET_TAG else {0: "answered", ClaudeSession.INTERRUPTED: "interrupted"}.get(rc, "error"))
        sys.stderr.write("< voice %.1fs (first word %s, %s)%s\n" % (
            time.time() - t0, "%.1fs" % first if first is not None else "-", went,
            "  STOPPED" if text == STOPPED else ""))
        sys.stderr.flush()
        if turn is not None:                 # used once: kept until the record says whether its turn was committed
            if _LIVE_SESSION.get((session, "voice")) is turn:
                _LIVE_SESSION.pop((session, "voice"), None)
            cv = call_voice(session)
            with cv.lock:
                cv.forks[ident] = {"sid": turn.sid, "pos": self.pos_after, "words": sbledger.words(raw), "engine": turn}
            turn.finish()
        _answer(apath, text)


def cmd_serve(args):
    """Watch the spool, so a client over ssh does not pay process startup twice.

    Typed questions and listening go to the meeting agent (--model, the deep
    one); voice mode to a quick model (--voice-model) on its own thread, which
    hands real work back to the meeting agent."""
    ensure_dirs()
    running = server_pid()
    if running is not None and running != os.getpid():      # its own pid: re-run with new code
        sys.stderr.write("standby-agent: already serving (pid %d)\n" % running)
        return 0
    if not hold_server_lock():
        sys.stderr.write("standby-agent: already serving (another server holds %s)\n" % LOCKFILE)
        return 0
    # SIGTERM must reach the finally block, or the pidfile outlives the process
    # and every later liveness check is a lie.
    import signal as _signal

    def _term(_signum, _frame):
        raise KeyboardInterrupt
    _signal.signal(_signal.SIGTERM, _term)
    with open(PIDFILE + ".tmp", "w") as fh:            # whole or not at all: never read empty
        fh.write("%d\n" % os.getpid())
    os.replace(PIDFILE + ".tmp", PIDFILE)
    backend = Backend(args, args.model)
    voice = Voice(args, backend, getattr(args, "voice_model", None) or args.model)
    stamp, looked, waited_for = code_stamp(), time.time(), None
    shown = lambda m: m if model_for(m) == m else "%s (%s is not available)" % (model_for(m), m)
    sys.stderr.write("standby-agent: serving %s (engine=%s, meeting agent %s, voice %s, code of %s)\n"
                     % (SPOOL, args.engine, shown(backend.model), shown(voice.model), _stamp_text(stamp)))
    sys.stderr.flush()
    warmed, acked, waiting = {}, {}, set()
    signin_wait = {}                  # session -> no listen push before then: Claude Code could not sign in
    settled = 0.0

    def take(name):
        path = os.path.join(SPOOL, name)
        try:
            with open(path) as fh:
                text = fh.read().strip()
        except IOError:
            return None
        os.remove(path)
        return text

    try:
        while True:
            if time.time() - looked > CODE_CHECK:
                looked = time.time()
                if code_stamp() != stamp:
                    why = restart_blocker(backend, voice)
                    if why is None:
                        restart_in_place(code_stamp())
                    elif why != waited_for:
                        waited_for = why
                        sys.stderr.write("standby-agent: new code on disk; waiting to restart: %s\n" % why)
                        sys.stderr.flush()
            session = current_session()
            if time.time() - settled > 0.25:
                settle_holds(backend, acked)
                settled = time.time()
            held = session in acked           # open in Claude Code: see `hold`
            # A meeting is live: have both Claude Codes up before anyone asks.
            # Not more than once a minute, should one keep failing to start.
            if (session != "none" and args.engine == "claude" and not held
                    and time.time() - warmed.get(session, 0) > 60):
                warmed[session] = time.time()
                with backend.lock:
                    backend.feeder(session)
                    prewarm(session, backend.model)
                if not (is_talk(session) and not voice_meta(session)):
                    voice.submit(("spawn", session))   # a call's voice waits for its voice.json: the app's warm-up comes after it
            # Voice questions (.vq) and warm-ups (.w) are the voice thread's.
            pending_q = sorted(n for n in os.listdir(SPOOL) if n.endswith(".q"))
            if held:
                # Questions and transcript wait for the conversation to come back.
                for name in pending_q:
                    if name not in waiting:
                        waiting.add(name)
                        with open(os.path.join(SPOOL, name[:-2] + ".p"), "a") as fh:
                            fh.write(json.dumps({"kind": "tool", "text": HELD_STEP, "t": 0}) + "\n")
                time.sleep(POLL)
                continue
            waiting.clear()

            # 1. typed questions: the meeting agent, with any unsent transcript
            for name in pending_q:
                question = take(name)
                if not question:
                    continue
                ident = name[:-2]
                apath, cpath = (os.path.join(SPOOL, ident + ext) for ext in (".a", ".c"))
                asked = asked_session(ident) or session       # an ended talk, continued by typing
                if os.path.exists(cpath):           # cancelled before its turn came
                    os.remove(cpath)
                    _answer(apath, STOPPED)
                    continue
                if asked != session and holder(asked) is not None:
                    _answer(apath, "This conversation is open in Claude Code in Terminal. "
                                   "Quit it there, then ask again.")
                    continue
                voiced = question.startswith(VOICE_TAG)       # an older client's voice question
                if voiced:
                    question = question[len(VOICE_TAG):].strip()
                words = question.startswith(WORDS_TAG)        # Standby's own pass, not the user's question
                if words:
                    question = question[len(WORDS_TAG):].strip()
                t0, timing, marker = time.time(), {}, [DeepMarker()]
                progress = _progress_writer(os.path.join(SPOOL, ident + ".p"), t0, timing, marker)
                stopping = lambda _c=cpath: os.path.exists(_c)
                with backend.lock:
                    text, rc, elapsed, fed = backend.ask(VOICE_RULES if voiced else "[QUESTION]",
                                                         question, asked, progress, stopping, question,
                                                         label="voice" if voiced else "words" if words else "question")
                sys.stderr.write("> %s  (+%d unsent lines)\n" % (question, fed))
                if rc == 0:
                    text = answer_suggestions(asked, text, os.path.join(SPOOL, ident + ".p"), t0)
                if os.path.exists(cpath):
                    os.remove(cpath)
                    if rc == ClaudeSession.INTERRUPTED:
                        text = STOPPED
                if rc == 0 and asked != "none":
                    voice.remember(asked, "Typed in the chat: %s\n%s answered: %s"
                                          % (question,
                                             "The meeting agent" if listens(asked) else "Claude", text))
                first = timing.get("first")
                sys.stderr.write("< %.1fs (first word %s, %s)%s\n" % (
                    elapsed, "%.1fs" % first if first is not None else "-", backend.model,
                    "  STOPPED" if text == STOPPED else ""))
                sys.stderr.flush()
                _answer(apath, text)

            # 2. otherwise, push new transcript as a silent listen turn (meetings only)
            if not pending_q and session != "none" and args.engine == "claude" and listens(session):
                with backend.lock:
                    feeder = backend.feeder(session)
                    rows = feeder.unsent()
                    if not feeder.due(rows) or time.time() < signin_wait.get(session, 0):
                        rows = None             # (or Claude Code could not sign in a moment ago)
                    else:
                        t0 = time.time()
                        interrupt = lambda: backend.wanted.is_set() or any(
                            f.endswith(".q") for f in os.listdir(SPOOL)) or os.path.exists(hold_path(session))
                        text, rc = engine_claude(transcript_block(rows, session) + suggest_rule(session),
                                                 session, backend.model, LISTEN_TIMEOUT,
                                                 should_interrupt=interrupt, max_total=LISTEN_MAX, label="listen")
                        # Interrupted turns still delivered the transcript message,
                        # so those lines are in the conversation: do not resend.
                        if rc in (0, ClaudeSession.INTERRUPTED):
                            feeder.mark(len(rows))
                        else:                   # a failed push is tried again after its gap, not at once
                            feeder.touch()
                        if rc == 0:
                            text, items = parse_suggestions(text)
                            record_suggestions(session, items, "listen")
                            note(session, text)
                        elif rc == ClaudeSession.SIGNIN:
                            signin_wait[session] = time.time() + SIGNIN_BACKOFF
                if rows is not None:
                    status = {0: "", ClaudeSession.INTERRUPTED: "  INTERRUPTED for a question",
                              ClaudeSession.HELD: "  HELD: open in another Claude Code, the lines wait",
                              ClaudeSession.SIGNIN: "  FAILED: Claude Code can't sign in; the next push waits %ds"
                              % SIGNIN_BACKOFF}.get(rc, "  FAILED: %s" % text[:200])
                    sys.stderr.write("listen: pushed %d lines to %s in %.1fs%s\n"
                                     % (len(rows), session, time.time() - t0, status))
                    sys.stderr.flush()
                    continue
            time.sleep(POLL)
    except KeyboardInterrupt:
        pass
    finally:
        for engine in _LIVE_SESSION.values():
            engine.stop()
        if server_pid() == os.getpid():
            try:
                os.remove(PIDFILE)
            except OSError:
                pass
    return 0


def note(session, reply):
    """A listen turn's reply: a period, or a few lines worth knowing. Those go
    to the notes the voice reads."""
    reply = (reply or "").strip()
    if sum(ch.isalnum() for ch in reply) < 3 or reply.startswith("("):
        return
    with open(os.path.join(LIVE, session + ".notes.md"), "a") as fh:
        fh.write("[%s] %s\n" % (time.strftime("%H:%M"), reply[:1200]))


def cmd_enqueue(args):
    """Client side of serve: drop a question, stream progress, print the answer.

    There is no fixed deadline: a question may take minutes. We wait as long as
    the server is alive; the server itself gives up only on a stuck (silent)
    turn. With --json every line on stdout is a JSON event, for the UI:
      {"type": "progress", "kind": "tool"|"text", "text": ..., "t": seconds}
      {"type": "answer", "text": ...}
    Otherwise progress goes to stderr and only the answer to stdout.
    """
    ensure_dirs()
    question = " ".join(args.question).strip()
    if not question:
        die("nothing to ask")
    ident = "%d-%04d" % (int(time.time() * 1000), random.randint(0, 9999))
    if getattr(args, "session", None):      # before the question appears: the server may take it at once
        with open(os.path.join(SPOOL, ident + ASKED_FOR), "w") as fh:
            fh.write(args.session)
    tmp = os.path.join(SPOOL, ident + ".q.tmp")
    with open(tmp, "w") as fh:
        fh.write(question)
    # Voice questions go to the voice's own thread, and never stop the
    # meeting agent's listening: a file kind of their own.
    os.rename(tmp, os.path.join(SPOOL, ident + (".vq" if question.startswith(VOICE_TAG) else ".q")))
    if args.json:                                  # "at": when it was queued, on this machine's clock
        print(json.dumps({"type": "queued", "id": ident, "at": round(time.time(), 3)}), flush=True)
    apath = os.path.join(SPOOL, ident + ".a")
    ppath = os.path.join(SPOOL, ident + ".p")
    seen = 0
    missing_since = None

    def pump_progress():
        nonlocal seen
        try:
            with open(ppath) as fh:
                lines = fh.read().splitlines()
        except IOError:
            return
        for line in lines[seen:]:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if args.json:
                ev["type"] = "progress"
                print(json.dumps(ev, ensure_ascii=False), flush=True)
            elif ev.get("kind") == "tool":
                sys.stderr.write("  . %s\n" % ev.get("text", "")); sys.stderr.flush()
        seen = len(lines)

    while True:
        pump_progress()
        if os.path.exists(apath):
            with open(apath) as fh:
                answer = fh.read().rstrip()
            for f in (apath, ppath):
                try:
                    os.remove(f)
                except OSError:
                    pass
            if args.json:
                print(json.dumps({"type": "answer", "text": answer}, ensure_ascii=False))
            else:
                print(answer)
            return 0
        if server_pid() is None:
            missing_since = missing_since or time.time()
            if time.time() - missing_since > 10:
                die("the agent server is not running (standby-agent serve)")
        else:
            missing_since = None
        time.sleep(POLL)


def cmd_warm(args):
    """Voice mode opened: the voice catches up on the meeting now, so the first
    spoken question does not pay for it."""
    ensure_dirs()
    ident = "%d-%04d" % (int(time.time() * 1000), random.randint(0, 9999))
    with open(os.path.join(SPOOL, ident + ".w.tmp"), "w") as fh:
        fh.write("voice")
    os.rename(os.path.join(SPOOL, ident + ".w.tmp"), os.path.join(SPOOL, ident + ".w"))
    return 0


def cmd_cancel(args):
    """Stop a question (by the id `q --json` reported): a waiting one is skipped,
    a running one is interrupted. Its answer becomes "(stopped)"."""
    ensure_dirs()
    if not re.match(r"^[0-9]+-[0-9]+$", args.id):
        die("not a question id: %r" % args.id)
    if os.path.exists(os.path.join(SPOOL, args.id + ".a")):
        return 0                                  # already answered
    open(os.path.join(SPOOL, args.id + ".c"), "w").close()
    return 0


GIST_MARK = "GIST:"


def decision_lines(out):
    """(points, gist) from the model's reply: up to 3 decisions, one a line, list marks and
    empty lines dropped; or, when nothing was decided, the one line it gave after GIST:.
    Exactly one of the two comes back (the other empty), or both empty if it said nothing."""
    rows, gist = [], ""
    for line in (out or "").splitlines():
        line = re.sub(r"^\s*(?:[-*\u2022]|\d+[.)])\s*", "", line).strip()
        if not line:
            continue
        if line.upper().startswith(GIST_MARK):
            gist = gist or line[len(GIST_MARK):].strip()[:120]
        elif line.strip(".").lower() not in ("none", "nothing", "no decisions"):
            rows.append(line[:200])
    return (rows[:3], "") if rows else ([], gist)


def cmd_decisions(args):
    """What a call or meeting came to, for its card in the thread: one cheap, tool-less,
    throwaway call on its words (stdin), never a turn in the agent's own conversation, so it
    reads the same whether it ran on the agent or on a copy of it. Prints up to 3 lines of
    what was decided or the key points; or, when nothing was, one line "GIST: ..." saying what
    it was about, so a card always has something to keep. Nothing if there was no speech."""
    text = sys.stdin.read().strip()
    if not text:
        return 0
    prompt = ("Below is a voice call or meeting involving the user and their assistant (the words are "
              "machine speech-to-text, so expect typos). If something was decided, agreed or settled, "
              "or there are key points worth remembering, list them: at most 3, the most important "
              "first, each one short line of at most 15 words, no list marks. Lines that start with "
              "\"Handed to Claude Code:\" are work the user sent to their coding agent during the call, and "
              "\"Claude Code came back:\" is what it answered: each is a key point, said as what was asked "
              "and, briefly, what came back. \"Voice ran:\" lines are steps the voice took itself. If nothing was decided "
              "and there are no key points, reply with ONE line that starts with GIST: and then one "
              "short sentence, under 90 characters, saying what it was about in plain words, without "
              "calling anyone \"the user\" (for example: GIST: A quick sound check: the agent could "
              "hear you.). Nothing else.\n\n" + text[-12000:])
    asks = model_for(args.decisions_model)
    argv = [CLAUDE, "-p", prompt, "--model", asks, "--tools", "",
            "--strict-mcp-config", "--no-session-persistence", "--output-format", "json"]
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=120, cwd=AGENT if os.path.isdir(AGENT) else None)
    except subprocess.TimeoutExpired:
        print("decisions: the model took over 120 s", file=sys.stderr)
        return 1
    except OSError as exc:
        print("decisions: %s" % exc, file=sys.stderr)
        return 1
    out = r.stdout or ""
    try:
        res = json.loads(out)
    except ValueError:
        res = None
    # The model failing is said, with what it said, so the card's maker can log it and ask again.
    if r.returncode != 0 or (isinstance(res, dict) and res.get("is_error")):
        said = (r.stderr or "").strip().splitlines() or [str((res or {}).get("result") or out).strip()]
        print("decisions: claude exited %d: %s" % (r.returncode, said[-1][:300]), file=sys.stderr)
        return 1
    if isinstance(res, dict):
        out = res.get("result") if isinstance(res.get("result"), str) else ""
        used = res.get("modelUsage") if isinstance(res.get("modelUsage"), dict) else {}
        if used:
            note_model(asks, max(used, key=lambda m: (used[m] or {}).get("outputTokens") or 0))
            record_usage(args.session or current_session(), "decisions", "decisions",
                         (res.get("duration_ms") or 0) / 1000.0, usage_share(used, {}))
    points, gist = decision_lines(out)
    for line in points:
        print(line)
    if gist:
        print("%s %s" % (GIST_MARK, gist))
    return 0


def cmd_call_summary(args):
    """What a call from a Claude Code session discussed that the session doesn't know yet, for the
    user to add to it after the call: one tool-less, throwaway call on the call's words (stdin).
    Prints the note, or nothing when there's nothing new for it."""
    text = sys.stdin.read().strip()
    if not text:
        return 0
    prompt = ("Below is a voice call between the user and the voice of their Claude Code session (the words "
              "are machine speech-to-text, so expect typos). During the call, the Claude Code session itself "
              "only got the lines starting \"Handed to Claude Code:\", and sent back the ones starting "
              "\"Claude Code came back:\"; it never heard the rest (\"Voice ran:\" lines are steps the voice took itself). "
              "Write a short note for that session with "
              "what it doesn't know yet: what was discussed, decided or asked for, and what matters to the "
              "user. A few plain sentences. If there's nothing it doesn't already have, reply NONE.\n\n" + text[-12000:])
    asks = model_for(args.summary_model)
    argv = [CLAUDE, "-p", prompt, "--model", asks, "--tools", "",
            "--strict-mcp-config", "--no-session-persistence", "--output-format", "json"]
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=120, cwd=AGENT if os.path.isdir(AGENT) else None)
        res = json.loads(r.stdout or "")
    except (subprocess.TimeoutExpired, OSError, ValueError):
        return 1
    if not isinstance(res, dict) or res.get("is_error") or not isinstance(res.get("result"), str):
        return 1
    used = res.get("modelUsage") if isinstance(res.get("modelUsage"), dict) else {}
    if used:
        note_model(asks, max(used, key=lambda m: (used[m] or {}).get("outputTokens") or 0))
        record_usage(args.session or current_session(), "call-summary", "call-summary",
                     (res.get("duration_ms") or 0) / 1000.0, usage_share(used, {}))
    out = res["result"].strip()
    if out and out.strip(".").upper() != "NONE":
        print(out)
    return 0


# A Claude Code session's gist, for the voice of a call started from it (the app caches it per
# session): what Claude Code itself keeps is a few-word title, a recap of under 40 words when
# the user steps away, and a summary only once it compacts; the voice needs about a page.
CC_GIST_IN = 40000                # characters of the condensed session the model reads
CC_GIST_PROMPT = (
    "Below is a Claude Code session: the user's requests, Claude's replies and the tools it used, "
    "oldest first (with a summary of the earlier part if it was compacted). This same session, on a voice "
    "call, is about to talk with the user. Write what it needs to know, in at most 1000 words: "
    "the overall goal; what has been done and decided; open questions and next steps; the key names, "
    "files and commands, exactly as written; and last, where things stand now: what the user last asked "
    "or said, what was last being worked on, anything running, failing or waiting on the user, and "
    "anything to pick up on the call. Facts only: no advice, no greeting, no "
    "headings or markdown, short plain paragraphs. Call the person \"the user\".")


def cc_condensed(rows, limit=CC_GIST_IN):
    """A Claude Code transcript's rows (its .jsonl, parsed) as the plain lines the gist is made
    from: its title, a compaction's summary, recaps, the user's requests, Claude's words and the
    tools it used. Meta rows (notes, reminders, a meeting's lines) and subagents' rows are left
    out. Over `limit`, the first requests (the goal) and the newest part are kept."""
    lines, title = [], None
    for r in rows:
        if not isinstance(r, dict) or r.get("isSidechain"):
            continue
        kind = r.get("type")
        if kind in ("custom-title", "ai-title"):
            title = r.get("customTitle") or (title if kind == "ai-title" and title else r.get("aiTitle")) or title
            continue
        if kind == "system" and r.get("subtype") == "away_summary" and isinstance(r.get("content"), str):
            lines.append("Recap: " + r["content"].strip())
            continue
        msg = r.get("message") if isinstance(r.get("message"), dict) else {}
        content = msg.get("content")
        blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content if isinstance(content, list) else []
        if kind == "user":
            text = " ".join(b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text").strip()
            if not text:
                continue
            if r.get("isCompactSummary"):
                lines.append("Summary of the earlier part: " + text[:8000])
            elif not r.get("isMeta") and not text.startswith(("<command-", "<local-command", "[Standby")):
                lines.append("User: " + " ".join(text.split())[:1500])
        elif kind == "assistant":
            for b in blocks:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text", "").strip():
                    lines.append("Claude: " + " ".join(b["text"].split())[:800])
                elif b.get("type") == "tool_use":
                    inp = b.get("input") if isinstance(b.get("input"), dict) else {}
                    what = inp.get("file_path") or inp.get("command") or inp.get("pattern") or inp.get("description") or ""
                    lines.append("Claude used %s%s" % (b.get("name") or "a tool", (": " + " ".join(str(what).split())[:160]) if what else ""))
    head = ["Title: " + title] if title else []
    text = "\n".join(head + lines)
    if len(text) <= limit:
        return text
    firsts = [l for l in lines if l.startswith("User: ")][:3]
    keep = "\n".join(head + ["First requests:"] + firsts + ["...", "Most recent:"])
    return keep + "\n" + text[-(limit - len(keep) - 1):].split("\n", 1)[-1]


def cmd_cc_gist(args):
    """What a Claude Code session has been working on, in about a page, for the voice of a call
    started from it: one cheap, tool-less, throwaway model call on its condensed transcript.
    Prints the gist, or nothing (an empty session, or the model couldn't be asked)."""
    rows = []
    try:
        with open(args.transcript, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    pass
    except OSError:
        return 1
    text = cc_condensed(rows)
    if not text.strip():
        return 0
    asks = model_for(args.gist_model)
    argv = [CLAUDE, "-p", CC_GIST_PROMPT + "\n\n" + text, "--model", asks, "--tools", "",
            "--strict-mcp-config", "--no-session-persistence", "--output-format", "json"]
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=120, cwd=AGENT if os.path.isdir(AGENT) else None)
    except (subprocess.TimeoutExpired, OSError):
        return 1
    try:
        res = json.loads(r.stdout or "")
    except ValueError:
        return 1
    out = res.get("result") if isinstance(res, dict) and isinstance(res.get("result"), str) else ""
    if isinstance(res, dict) and isinstance(res.get("modelUsage"), dict) and res["modelUsage"]:
        record_usage(args.session or current_session(), "cc-gist", "cc-gist",
                     (res.get("duration_ms") or 0) / 1000.0, usage_share(res["modelUsage"], {}))
    if out.strip():
        print(out.strip())
    return 0


def cmd_title(args):
    """Suggest a short title for a session from the start of its transcript.

    One cheap, tool-less, throwaway call (never touches the meeting's
    conversation). Prints the title, or nothing if there is not enough text.
    """
    if args.stdin:
        # A talk: no transcript, so the app sends the start of its chat.
        text, least = sys.stdin.read().strip(), 20
        what = ("Below is the start of a conversation between a user and their assistant "
                "(the user's words may be machine speech-to-text). Reply with a short, specific "
                "title for the conversation")
    else:
        session = args.session or current_session()
        rows = []
        try:
            with open(os.path.join(LIVE, session + ".jsonl")) as fh:
                for line in fh:
                    try:
                        rows.append(json.loads(line))
                    except ValueError:
                        pass
        except IOError:
            pass
        text, least = " ".join((r.get("text") or "").strip() for r in rows[:80]).strip(), 80
        what = ("Below is the start of a meeting transcript (machine speech-to-text, "
                "so expect typos). Reply with a short, specific title for the meeting")
    if len(text) < least:
        return 0
    prompt = what + ", 3 to 7 words, no quotes, no trailing punctuation, nothing else.\n\n" + text[:6000]
    asks = model_for(args.title_model)
    argv = [CLAUDE, "-p", prompt, "--model", asks, "--tools", "",
            "--strict-mcp-config", "--no-session-persistence", "--output-format", "json"]
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=90, cwd=AGENT if os.path.isdir(AGENT) else None)
    except (subprocess.TimeoutExpired, OSError):
        return 1
    out = r.stdout or ""
    try:
        res = json.loads(out)
    except ValueError:
        res = None
    if isinstance(res, dict):
        out = res.get("result") if isinstance(res.get("result"), str) else ""
        used = res.get("modelUsage") if isinstance(res.get("modelUsage"), dict) else {}
        if used:                                     # one call, no conversation: all of it is this call's
            note_model(asks, max(used, key=lambda m: (used[m] or {}).get("outputTokens") or 0))
            record_usage(args.session or current_session(), "title", "title",
                         (res.get("duration_ms") or 0) / 1000.0, usage_share(used, {}))
    title = out.strip().splitlines()
    title = title[0].strip().strip('"\'').rstrip(".") if title else ""
    if title:
        print(title[:80])
    return 0 if title else 1


def cmd_status(_args):
    session = current_session()
    print("session : %s" % session)
    print("engine  : claude at %s%s"
          % (CLAUDE, "" if os.path.exists(CLAUDE) else "  MISSING"))
    pid = server_pid()
    if pid is not None:
        print("server  : running (pid %d)" % pid)
    else:
        print("server  : not running")
    if session != "none":
        sid, _fresh = session_uuid(session, create=False)
        print("convo   : %s" % (sid or "(none yet)"))
    if os.path.exists(ANSWERS):
        with open(ANSWERS) as fh:
            rows = [l for l in fh if l.strip()]
        print("answered: %d question(s)" % len(rows))
        if rows:
            last = json.loads(rows[-1])
            print("last    : %.1fs  %r" % (last["seconds"], last["q"][:60]))
    return 0


def cmd_dryrun(args):
    session = args.session or current_session()
    sid, _fresh = session_uuid(session, create=False)
    argv = build_argv(session, args.model, True,
                      sid or "<new-uuid-at-first-question>", stream=True)
    shown = []
    for item in argv:
        if len(item) > 120:
            shown.append("<%d chars of system prompt>" % len(item))
        else:
            shown.append(item)
    print(" \\\n  ".join(shown))
    return 0


def main():
    # These options have to work on BOTH sides of the subcommand. Declaring them
    # only on the top-level parser made "standby-agent serve --model sonnet" a
    # usage error, which killed the server instantly at startup and cost an
    # afternoon. Declared once here and inherited by every subparser with
    # default=SUPPRESS, so a subparser sets them only when actually passed and
    # never clobbers a value given before the subcommand.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--engine", choices=sorted(ENGINES),
                        default=argparse.SUPPRESS)
    common.add_argument("--model", default=argparse.SUPPRESS)
    common.add_argument("--voice-model", default=argparse.SUPPRESS)
    common.add_argument("--timeout", type=int, default=argparse.SUPPRESS,
                        help="per-question deadline in seconds")
    common.add_argument("--session", default=argparse.SUPPRESS,
                        help="override the live session name")

    ap = argparse.ArgumentParser(prog="standby-agent")
    ap.add_argument("--engine", choices=sorted(ENGINES), default="claude")
    ap.add_argument("--model", default="sonnet")
    ap.add_argument("--voice-model", default=None,
                    help="voice mode's quick model (default: --model); it hands real "
                         "work to the meeting agent, which runs on --model")
    ap.add_argument("--timeout", type=int, default=300,
                    help="give up on a question after this many seconds of NO "
                         "activity (a working agent is never cut off)")
    ap.add_argument("--session", help="override the live session name")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("ask", parents=[common],
                       help="answer one question now (own process)")
    p.add_argument("question", nargs="+")
    p.add_argument("--timing", action="store_true")
    p.set_defaults(func=cmd_ask)

    p = sub.add_parser("serve", parents=[common],
                       help="watch the spool and answer questions")
    p.set_defaults(func=cmd_serve)

    p = sub.add_parser("q", parents=[common],
                       help="enqueue a question for a running server")
    p.add_argument("question", nargs="+")
    p.add_argument("--json", action="store_true",
                   help="stream JSON progress events, then the answer")
    p.set_defaults(func=cmd_enqueue)

    p = sub.add_parser("warm", parents=[common],
                       help="voice mode opened: brief the voice now")
    p.set_defaults(func=cmd_warm)

    p = sub.add_parser("cancel", parents=[common],
                       help="stop a question (its id comes from q --json)")
    p.add_argument("id")
    p.set_defaults(func=cmd_cancel)

    p = sub.add_parser("title", parents=[common],
                       help="suggest a short title for a session")
    p.add_argument("--title-model", default="haiku")
    p.add_argument("--stdin", action="store_true", help="title this text (a talk's chat), not the transcript")
    p.set_defaults(func=cmd_title)


    p = sub.add_parser("decisions", parents=[common],
                       help="a call's 2-3 decisions from its chat on stdin, one a line (the call card)")
    p.add_argument("--decisions-model", default="sonnet")
    p.set_defaults(func=cmd_decisions)
    p = sub.add_parser("call-summary", parents=[common],
                       help="what a call from a Claude Code session discussed that it doesn't know yet (its words on stdin)")
    p.add_argument("--summary-model", default="sonnet")
    p.set_defaults(func=cmd_call_summary)
    p = sub.add_parser("cc-gist", parents=[common],
                       help="what a Claude Code session has been working on, about a page, for a call's voice")
    p.add_argument("--transcript", required=True, help="the session's .jsonl")
    p.add_argument("--gist-model", default="haiku")
    p.set_defaults(func=cmd_cc_gist)
    p = sub.add_parser("where", parents=[common],
                       help="the folder this session's conversation lives in, as JSON")
    p.set_defaults(func=cmd_where)

    p = sub.add_parser("open-where", help="is this conversation open in another Claude Code now, as JSON")
    p.add_argument("--id", required=True)
    p.set_defaults(func=cmd_open_where)

    p = sub.add_parser("deliver", help="a message to one conversation, as JSON")
    p.add_argument("--id", required=True, help="the conversation")
    p.add_argument("--text", required=True, help="base64 UTF-8")
    p.add_argument("--folder", help="base64 UTF-8: where to run a turn, if Standby runs it")
    p.add_argument("--model", help="the model for a turn Standby runs itself (an alias or a full id)")
    p.set_defaults(func=cmd_deliver)
    p = sub.add_parser("deliver-run", help="(internal) run one conversation's waiting messages")
    p.add_argument("--id", required=True)
    p.set_defaults(func=cmd_deliver_run)
    p = sub.add_parser("delete-agent", help="a conversation Standby started, deleted for good, as JSON")
    p.add_argument("--id", required=True)
    p.set_defaults(func=cmd_delete_agent)

    p = sub.add_parser("conversations", help="the user's Claude Code conversations, newest first, as JSON")
    p.add_argument("--limit", type=int, default=20, help="at most this many")
    p.set_defaults(func=cmd_conversations)

    p = sub.add_parser("version", help="a hash of the agent's own files, as JSON (is it current?)")
    p.set_defaults(func=cmd_version)
    p = sub.add_parser("projects", help="recent project folders and the default, as JSON")
    p.add_argument("--default", default="", help="the app's default folder, to give back as an absolute path")
    p.add_argument("--limit", type=int, default=0, help="how many")
    p.set_defaults(func=cmd_projects)

    p = sub.add_parser("check-folder", help="is a folder there, with a CLAUDE.md? as JSON")
    p.add_argument("path")
    p.set_defaults(func=cmd_check_folder)

    p = sub.add_parser("resume-cmd", parents=[common],
                       help="how to continue this session in Claude Code, as JSON")
    p.set_defaults(func=cmd_resume_cmd)

    p = sub.add_parser("hold", parents=[common],
                       help="run Claude Code on the meeting's conversation: hold -- claude --resume ID")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_hold)

    p = sub.add_parser("held", parents=[common],
                       help="exit 0 while the conversation is open in Claude Code (prints the pid)")
    p.set_defaults(func=cmd_held)

    p = sub.add_parser("copy", parents=[common],
                       help="a session waiting for its conversation to close elsewhere goes on with a copy")
    p.set_defaults(func=cmd_copy)

    p = sub.add_parser("prompt", parents=[common],
                       help="print the instructions Claude gets, as JSON")
    p.set_defaults(func=cmd_prompt)

    p = sub.add_parser("status", parents=[common],
                       help="engine, skill, server, conversation")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("probe", parents=[common],
                       help="one short Claude turn: can Claude be reached now? as JSON")
    p.set_defaults(func=cmd_probe)

    p = sub.add_parser("alive", parents=[common],
                       help="exit 0 if the server is running (prints its pid)")
    p.set_defaults(func=cmd_alive)

    p = sub.add_parser("stop", parents=[common], help="stop the server")
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("dry-run", parents=[common],
                       help="print the exact claude command")
    p.add_argument("question", nargs="*")
    p.set_defaults(func=cmd_dryrun)

    args = ap.parse_args()
    if not getattr(args, "func", None):
        ap.print_help()
        return 1
    if getattr(args, "session", None) and not session_name(args.session):
        die("not a session name: %r (letters, digits, - and _ only)" % args.session)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
